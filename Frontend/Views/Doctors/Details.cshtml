@model Frontend.Models.Doctors.DoctorResponseDto
@{
    ViewData["Title"] = "Doctor Details";
}
<div class="hero-panel mb-4"><span class="badge-soft mb-3"><i class="bi bi-person-vcard"></i> Doctor</span><h1 class="h2 fw-bold">@Model.FullName</h1><p class="mb-0">@Model.Qualification • @Model.Specialization</p></div>
<div class="content-card"><div class="card-body p-4"><div class="row g-3"><div class="col-md-4"><div class="profile-stat"><div class="label">Phone</div><div class="value">@Model.Phone</div></div></div><div class="col-md-4"><div class="profile-stat"><div class="label">Email</div><div class="value">@(Model.Email ?? "N/A")</div></div></div><div class="col-md-4"><div class="profile-stat"><div class="label">License</div><div class="value">@Model.LicenseNumber</div></div></div><div class="col-md-4"><div class="profile-stat"><div class="label">Department</div><div class="value">@Model.DepartmentName</div></div></div><div class="col-md-4"><div class="profile-stat"><div class="label">Fee</div><div class="value">₹@Model.ConsultationFee</div></div></div><div class="col-md-4"><div class="profile-stat"><div class="label">Teleconsultation</div><div class="value">@(Model.SupportsTeleConsultation ? "Yes" : "No")</div></div></div></div><a asp-action="Index" class="btn btn-outline-primary mt-4">Back to doctors</a></div></div>

@model List<Frontend.Models.Doctors.DoctorLeaveResponseDto>
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Doctor Leaves";

    var role = Context.Session.GetString("Role") ?? string.Empty;
    var isAdmin = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);
    var isReception = string.Equals(role, "Receptionist", StringComparison.OrdinalIgnoreCase);
    var isDoctor = string.Equals(role, "Doctor", StringComparison.OrdinalIgnoreCase);

    var doctorId = ViewBag.DoctorId as int?;
    var status = ViewBag.Status as string;
}

<div class="page-header">
    <div>
        <span class="badge-soft">
            <i class="bi bi-calendar-x"></i> Doctor leave
        </span>

        <h1>@(isDoctor ? "My Leave Requests" : "Doctor Leave Requests")</h1>

        <p class="page-subtitle">
            @(isDoctor
                        ? "Apply for leave and track approval status from your own doctor account."
                        : "Doctors submit leave from their portal. Admin approval controls whether leave blocks availability.")
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @if (isDoctor)
        {
            <a asp-action="RequestLeave" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Apply Leave
            </a>
        }

        @if (isAdmin || isReception)
        {
            <a asp-action="Leaves" asp-route-status="Pending" class="btn btn-outline-primary">Pending</a>
            <a asp-action="Leaves" asp-route-status="Approved" class="btn btn-outline-success">Approved</a>
            <a asp-action="Leaves" asp-route-status="Rejected" class="btn btn-outline-danger">Rejected</a>
            <a asp-action="Leaves" class="btn btn-outline-secondary">All</a>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <h3>No leave requests found</h3>
        <p>@(isDoctor ? "Your leave applications will appear here." : "New leave applications will appear here.")</p>
    </div>
}
else
{
    <div class="card border-0 queue-board">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 professional-table">
                    <thead>
                        <tr>
                            <th>Start Date</th>
                            <th>End Date</th>

                            @if (!isDoctor)
                            {
                                <th>Doctor ID</th>
                            }

                            <th>Reason</th>
                            <th>Status</th>
                            <th>Reviewed</th>

                            @if (isAdmin)
                            {
                                <th class="text-end">Admin Action</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@item.EndDate.ToString("dd MMM yyyy")</td>

                                @if (!isDoctor)
                                {
                                    <td>@item.DoctorId</td>
                                }

                                <td>@(string.IsNullOrWhiteSpace(item.Reason) ? "-" : item.Reason)</td>

                                <td>
                                    <span class="queue-status-pill small">@item.Status</span>
                                </td>

                                <td>
                                    @if (item.ReviewedAtUtc.HasValue)
                                    {
                                        <span>@item.ReviewedAtUtc.Value.ToString("dd MMM yyyy HH:mm")</span>

                                        @if (!string.IsNullOrWhiteSpace(item.ReviewedBy))
                                        {
                                            <small class="d-block text-muted">by @item.ReviewedBy</small>
                                        }
                                    }
                                    else
                                    {
                                        <span>Pending</span>
                                    }
                                </td>

                                @if (isAdmin)
                                {
                                    <td class="text-end">
                                        @if (string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="queue-row-actions justify-content-end">
                                                <form asp-action="ApproveLeave" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="leaveId" value="@item.Id" />
                                                    <input type="hidden" name="doctorId" value="@doctorId" />
                                                    <input type="hidden" name="status" value="@status" />
                                                    <button class="btn btn-sm btn-success">Approve</button>
                                                </form>

                                                <form asp-action="RejectLeave" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="leaveId" value="@item.Id" />
                                                    <input type="hidden" name="doctorId" value="@doctorId" />
                                                    <input type="hidden" name="status" value="@status" />
                                                    <button class="btn btn-sm btn-outline-danger">Reject</button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No action</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
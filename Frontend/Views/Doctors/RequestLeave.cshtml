@model Frontend.Models.Doctors.CreateDoctorLeaveViewModel
@{
    ViewData["Title"] = "Apply Doctor Leave";
}

<div class="page-header">
    <div>
        <span class="badge-soft"><i class="bi bi-calendar-plus"></i> Leave application</span>
        <h1>Apply for Leave</h1>
        <p class="page-subtitle">Submit the request here. Admin approval is required before the date is marked unavailable.</p>
    </div>
</div>

<div class="card border-0 shadow-sm form-card">
    <div class="card-body">
        <form asp-action="RequestLeave" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-md-4">
                <label asp-for="DoctorId" class="form-label"></label>
                <input asp-for="DoctorId" class="form-control" />
                <span asp-validation-for="DoctorId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="LeaveDate" class="form-label"></label>
                <input asp-for="LeaveDate" type="date" class="form-control" />
                <span asp-validation-for="LeaveDate" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Reason" class="form-label"></label>
                <textarea asp-for="Reason" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary">Submit for Admin Approval</button>
                <a asp-action="Leaves" asp-route-doctorId="@Model.DoctorId" class="btn btn-outline-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

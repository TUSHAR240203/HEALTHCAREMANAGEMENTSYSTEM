@model Frontend.Models.Doctors.UpdateDoctorViewModel

@{
    var isEdit = string.Equals(Context.Request.Query["mode"], "edit", StringComparison.OrdinalIgnoreCase);

    ViewData["Title"] = "My Doctor Profile";

    var photo = !string.IsNullOrWhiteSpace(Model.PhotoUrl) ? Model.PhotoUrl : null;

    var initial = string.IsNullOrWhiteSpace(Model.FullName)
        ? "D"
        : Model.FullName[..1].ToUpperInvariant();
}

<div class="doctor-profile-page">

    <!-- HERO -->
    <section class="doctor-profile-hero">
        <div class="doctor-hero-left">

            <div class="doctor-profile-avatar" id="doctorHeroPhotoPreview">
                @if (!string.IsNullOrWhiteSpace(photo))
                {
                    <img src="@photo" />
                    <span style="display:none;">@initial</span>
                }
                else
                {
                    <img style="display:none;" />
                    <span>@initial</span>
                }
            </div>

            <div class="doctor-hero-text">
                <h1>@(string.IsNullOrWhiteSpace(Model.FullName) ? "Doctor Profile" : Model.FullName)</h1>
                <p>@Model.Qualification • @Model.Specialization</p>
            </div>

        </div>
    </section>

    <!-- CARD -->
    <div class="content-card doctor-profile-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-1">Doctor Profile</h4>
                <p class="text-muted mb-0">
                    @(isEdit ? "Update your doctor details." : "View your profile.")
                </p>
            </div>

            @if (!isEdit)
            {
                <a asp-action="MyProfile" asp-route-mode="edit" class="btn btn-primary">
                    Edit Profile
                </a>
            }
        </div>

        <form asp-action="MyProfile" method="post" enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />
            <input asp-for="AuthUserId" type="hidden" />
            <input asp-for="PhotoUrl" type="hidden" />

            @if (!isEdit)
            {
                <input type="hidden" asp-for="Gender" />
                <input type="hidden" asp-for="SupportsTeleConsultation" />
            }

            <div class="row g-4">

                <!-- PHOTO -->
                <div class="col-lg-4">
                    <div class="profile-upload-card">

                        <div class="profile-upload-preview" id="doctorPhotoPreview">
                            @if (!string.IsNullOrWhiteSpace(photo))
                            {
                                <img src="@photo" />
                                <span style="display:none;">@initial</span>
                            }
                            else
                            {
                                <img style="display:none;" />
                                <span>@initial</span>
                            }
                        </div>

                        <input asp-for="PhotoFile"
                               class="form-control mt-3"
                               type="file"
                               disabled="@(!isEdit)" />
                    </div>
                </div>

                <!-- FORM -->
                <div class="col-lg-8">
                    <div class="row g-3">

                        <input asp-for="FullName" class="form-control" readonly="@(!isEdit)" />
                        <input asp-for="Email" class="form-control" readonly="@(!isEdit)" />
                        <input asp-for="Phone" class="form-control" readonly="@(!isEdit)" />

                        <select asp-for="Gender" class="form-select" disabled="@(!isEdit)">
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>

                        <input asp-for="Qualification" class="form-control" readonly="@(!isEdit)" />
                        <input asp-for="Specialization" class="form-control" readonly="@(!isEdit)" />
                        <input asp-for="ConsultationFee" class="form-control" readonly="@(!isEdit)" />

                        <div class="form-check form-switch">
                            <input asp-for="SupportsTeleConsultation"
                                   class="form-check-input"
                                   disabled="@(!isEdit)" />
                            <label class="form-check-label">Teleconsultation</label>
                        </div>

                    </div>

                    <!-- ACTIONS -->
                    <div class="mt-4 text-end">
                        @if (isEdit)
                        {
                            <a asp-action="MyProfile" class="btn btn-outline-secondary">Cancel</a>

                            <button type="submit" class="btn btn-primary">
                                Save Profile
                            </button>
                        }
                    </div>

                </div>
            </div>
        </form>
    </div>
</div>
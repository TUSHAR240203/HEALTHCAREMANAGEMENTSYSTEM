@model Frontend.Models.Patients.PatientSearchViewModel

@{
    ViewData["Title"] = "Patients";
    var hasSearched = ViewBag.HasSearched as bool? ?? false;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Patients</h2>
            <p class="text-muted mb-0">
                Create, search, view, and manage patients.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Create Patient
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Query" class="form-label"></label>
                        <input asp-for="Query"
                               class="form-control"
                               placeholder="Name or general search" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="UHID" class="form-label"></label>
                        <input asp-for="UHID"
                               class="form-control"
                               placeholder="Enter UHID" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MobileNumber" class="form-label"></label>
                        <input asp-for="MobileNumber"
                               class="form-control"
                               placeholder="Enter mobile number" />
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Search
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">
                @(hasSearched ? "Filtered Patients" : "All Patients")
            </h2>

            <span class="badge bg-light text-dark">
                @(Model.Results?.Count ?? 0) result(s)
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>UHID</th>
                            <th>Full Name</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>Blood Group</th>
                            <th>Portal</th>
                            <th>Status</th>
                            <th style="width: 220px;">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Results != null && Model.Results.Count > 0)
                        {
                            foreach (var patient in Model.Results)
                            {
                                var patientId = patient.EffectivePatientId;

                                <tr>
                                    <td>@patientId</td>
                                    <td>@patient.DisplayUHID</td>
                                    <td>@patient.FullName</td>
                                    <td>@patient.MobileNumber</td>
                                    <td>@patient.Email</td>
                                    <td>@patient.BloodGroup</td>

                                    <td>
                                        @if (patient.PortalAccessEnabled)
                                        {
                                            <span class="badge bg-success">Enabled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Disabled</span>
                                        }
                                    </td>

                                    <td>@patient.StatusText</td>

                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            @if (patientId > 0)
                                            {
                                                <a asp-action="Details"
                                                       asp-route-id="@patientId"
                                                       class="btn btn-sm btn-outline-primary">
                                                    Details
                                                </a>

                                                <a asp-action="Edit"
                                                       asp-route-id="@patientId"
                                                       class="btn btn-sm btn-outline-warning">
                                                    Edit
                                                </a>

                                                <a asp-action="Delete"
                                                       asp-route-id="@patientId"
                                                       class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-danger small">
                                                    Invalid patient id
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    @(hasSearched
                                        ? "No matching patients found."
                                        : "No patients found.")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@model Frontend.Models.Patients.PatientResponseDto

@{
    ViewData["Title"] = "Patient Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Patient Details</h2>
            <p class="text-muted mb-0">Complete patient information</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">Patient ID</div>
                        <div class="fw-bold">@Model.Id</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">UHID</div>
                        <div class="fw-bold">@Model.UHID</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">Created At</div>
                        <div class="fw-bold">@Model.CreatedAtUtc</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">Full Name</div>
                        <div class="fw-bold">@Model.FullName</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">Date of Birth</div>
                        <div class="fw-bold">@Model.DateOfBirth.ToShortDateString()</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">Gender</div>
                        <div class="fw-bold">
                            @(Model.Gender == 1 ? "Male" : Model.Gender == 2 ? "Female" : "Other")
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">Mobile Number</div>
                        <div class="fw-bold">@Model.MobileNumber</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">Email</div>
                        <div class="fw-bold">@Model.Email</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">Blood Group</div>
                        <div class="fw-bold">@Model.BloodGroup</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">Portal Access</div>
                        <div class="fw-bold">@(Model.PortalAccessEnabled ? "Enabled" : "Disabled")</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">Portal Activated</div>
                        <div class="fw-bold">@(Model.PortalActivated ? "Yes" : "No")</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <div class="text-muted small">Status</div>
                        <div class="fw-bold">@Model.StatusText</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@using Microsoft.AspNetCore.Http
@{
    var isLoggedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString("AccessToken"));
    var role = Context.Session.GetString("Role") ?? string.Empty;
    var displayName = Context.Session.GetString("FullName");
    var mobileNumber = Context.Session.GetString("MobileNumber") ?? string.Empty;
    var photoUrl = Context.Session.GetString("PhotoUrl");
    var profileCompletion = Context.Session.GetInt32("ProfileCompletion") ?? 0;

    var isAdmin = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);
    var isReception = string.Equals(role, "Receptionist", StringComparison.OrdinalIgnoreCase);
    var isDoctor = string.Equals(role, "Doctor", StringComparison.OrdinalIgnoreCase);
    var isPatient = string.Equals(role, "Patient", StringComparison.OrdinalIgnoreCase);

    var currentPath = Context.Request.Path.Value ?? string.Empty;

    var avatarText = !string.IsNullOrWhiteSpace(displayName)
        ? displayName[..1].ToUpperInvariant()
        : (!string.IsNullOrWhiteSpace(role) ? role[..1].ToUpperInvariant() : "H");
}

<!DOCTYPE html>
<html lang="en" data-theme="default">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HMS Portal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <svg class="theme-svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
            <clipPath id="tealLiquidClip" clipPathUnits="objectBoundingBox">
                <path d="M0.04,0.23 C0.15,0.05,0.38,-0.02,0.57,0.06 C0.75,0.13,0.96,0.18,0.99,0.39 C1.02,0.60,0.85,0.73,0.75,0.87 C0.63,1.04,0.38,0.98,0.22,0.91 C0.06,0.84,-0.02,0.66,0.00,0.49 C0.01,0.39,-0.01,0.32,0.04,0.23Z"></path>
            </clipPath>
            <clipPath id="bloodSplatterClip" clipPathUnits="objectBoundingBox">
                <path d="M0.49,0 C0.58,0.10,0.67,0.16,0.78,0.21 C0.91,0.27,1.04,0.40,0.96,0.54 C0.88,0.68,0.71,0.66,0.65,0.80 C0.58,0.96,0.44,1.05,0.33,0.91 C0.23,0.77,0.10,0.83,0.03,0.69 C-0.04,0.55,0.10,0.45,0.15,0.34 C0.20,0.21,0.33,0.12,0.49,0Z"></path>
            </clipPath>
            <symbol id="themeBat" viewBox="0 0 132 74">
                <path d="M66 31c6-15 17-23 33-26-3 8 2 14 11 18 7 3 14 4 22 3-5 6-6 13-4 21 2 8 8 16 17 23-13-3-23-9-31-17-7-7-12-8-17-5-9 6-15 15-20 29-5-14-11-23-20-29-5-3-10-2-17 5-8 8-18 14-31 17 9-7 15-15 17-23 2-8 1-15-4-21 8 1 15 0 22-3 9-4 14-10 11-18 16 3 27 11 33 26Z"></path>
            </symbol>
            <symbol id="themeSpider" viewBox="0 0 64 64">
                <path d="M9 15c6 2 12 5 16 11M55 15c-6 2-12 5-16 11M5 29c7-1 13 1 18 5M59 29c-7-1-13 1-18 5M11 47c6-2 11-6 14-12M53 47c-6-2-11-6-14-12" fill="none" stroke="currentColor" stroke-width="3.1" stroke-linecap="round"/>
                <ellipse cx="32" cy="36" rx="11" ry="10" fill="currentColor"/>
                <circle cx="32" cy="22" r="7" fill="currentColor"/>
                <circle cx="29" cy="20" r="1.1" fill="#fff"/><circle cx="35" cy="20" r="1.1" fill="#fff"/>
            </symbol>
            <symbol id="themeWeb" viewBox="0 0 220 220">
                <path d="M0 0H220M0 0V220M30 0C22 62 25 130 70 220M65 0C60 54 65 116 112 220M105 0C105 47 116 101 180 220M0 30C62 22 130 25 220 70M0 65C54 60 116 65 220 112M0 105C47 105 101 116 220 180M0 0L220 220M42 0L220 178M0 42L178 220" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" opacity=".95"/>
            </symbol>
        </defs>
    </svg>

    <div class="theme-stage" aria-hidden="true">
        <div class="teal-light light-one"></div>
        <div class="teal-light light-two"></div>
        <div class="teal-blob blob-one"></div>
        <div class="teal-blob blob-two"></div>

        <div class="powder-scene">
            <div class="powder-glow powder-glow-one"></div>
            <div class="powder-glow powder-glow-two"></div>
            <div class="powder-orb powder-orb-one"></div>
            <div class="powder-orb powder-orb-two"></div>
            <div class="powder-ribbon powder-ribbon-one"></div>
            <div class="powder-ribbon powder-ribbon-two"></div>
        </div>

    </div>
    <div class="ambient-orb orb-one"></div>
    <div class="ambient-orb orb-two"></div>

    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="brand-block" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">
                    <i class="bi bi-hospital"></i>
                </span>
                <span>
                    <span class="brand-title">HMS Portal</span>
                    <small class="brand-subtitle">Role based hospital OS</small>
                </span>
            </a>

            <nav class="side-nav">
                <a class="side-link @(currentPath == "/" ? "active" : "")"
                       asp-controller="Home"
                       asp-action="Index">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>

                @if (isAdmin)
                {
                    <a class="side-link @(currentPath.StartsWith("/StaffUsers") ? "active" : "")"
                           asp-controller="StaffUsers"
                           asp-action="Index">
                        <i class="bi bi-person-gear"></i>
                        <span>Staff Users</span>
                    </a>
                }

                @if (isAdmin || isReception)
                {
                    <a class="side-link @(currentPath.StartsWith("/Patients") ? "active" : "")"
                           asp-controller="Patients"
                           asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Patients</span>
                    </a>

                    <a class="side-link @(currentPath.StartsWith("/Reception/Queue") ? "active" : "")"
                           asp-controller="Reception"
                           asp-action="Queue"
                           asp-route-departmentId="1">
                        <i class="bi bi-list-ol"></i>
                        <span>Queue</span>
                    </a>
                }

                @* Admin/Receptionist can see all doctors *@
                @if (isAdmin || isReception)
                {
                    <a class="side-link @(currentPath.StartsWith("/Doctors") && !currentPath.StartsWith("/Doctors/Leaves") ? "active" : "")"
                           asp-controller="Doctors"
                           asp-action="Index">
                        <i class="bi bi-heart-pulse"></i>
                        <span>Doctors</span>
                    </a>

                    <a class="side-link @(currentPath.StartsWith("/Doctors/Leaves") ? "active" : "")"
                           asp-controller="Doctors"
                           asp-action="Leaves">
                        <i class="bi bi-calendar-x"></i>
                        <span>Doctor Leaves</span>
                    </a>
                }

                @* Doctor can only see own doctor options *@
                @if (isDoctor)
                {
                    <a class="side-link @(currentPath.StartsWith("/Doctors/MyProfile") ? "active" : "")"
                           asp-controller="Doctors"
                           asp-action="MyProfile">
                        <i class="bi bi-person-badge"></i>
                        <span>My Profile</span>
                    </a>

                    <a class="side-link @(currentPath.StartsWith("/Doctors/MySchedule") ? "active" : "")"
                           asp-controller="Doctors"
                           asp-action="MySchedule">
                        <i class="bi bi-clock-history"></i>
                        <span>My Schedule</span>
                    </a>

                    <a class="side-link @(currentPath.StartsWith("/Doctors/Leaves") ? "active" : "")"
                           asp-controller="Doctors"
                           asp-action="Leaves">
                        <i class="bi bi-calendar-check"></i>
                        <span>My Leaves</span>
                    </a>

                    <a class="side-link @(currentPath.StartsWith("/Doctors/RequestLeave") ? "active" : "")"
                           asp-controller="Doctors"
                           asp-action="RequestLeave">
                        <i class="bi bi-calendar-plus"></i>
                        <span>Request Leave</span>
                    </a>
                }

                @if (isAdmin || isReception || isDoctor || isPatient)
                {
                    @if (isPatient)
                    {
                        <a class="side-link @(currentPath.StartsWith("/Appointments") && !currentPath.StartsWith("/Appointments/PatientBook") ? "active" : "")"
                               asp-controller="Appointments"
                               asp-action="ByPatient">
                            <i class="bi bi-calendar2-week"></i>
                            <span>My Appointments</span>
                        </a>

                        <a class="side-link @(currentPath.StartsWith("/Appointments/PatientBook") ? "active" : "")"
                               asp-controller="Appointments"
                               asp-action="PatientBook">
                            <i class="bi bi-calendar2-plus"></i>
                            <span>Book Appointment</span>
                        </a>
                    }
                    else
                    {
                        <a class="side-link @(currentPath.StartsWith("/Appointments") ? "active" : "")"
                               asp-controller="Appointments"
                               asp-action="Index">
                            <i class="bi bi-calendar2-week"></i>
                            <span>Appointments</span>
                        </a>
                    }
                }

                @if (isAdmin || isReception || isPatient)
                {
                    <a class="side-link @(currentPath.StartsWith("/Billing") ? "active" : "")"
                           asp-controller="Billing"
                           asp-action="ByPatient">
                        <i class="bi bi-receipt"></i>
                        <span>@(isPatient ? "My Bills" : "Billing")</span>
                    </a>
                }

                @if (isLoggedIn)
                {
                    @if (isPatient)
                    {
                        <a class="side-link @(currentPath.StartsWith("/Account/CompleteProfile") || currentPath.StartsWith("/Account/Profile") ? "active" : "")"
                               asp-controller="Account"
                               asp-action="CompleteProfile">
                            <i class="bi bi-person-circle"></i>
                            <span>Complete Profile</span>
                        </a>
                    }
                    else if (!isDoctor)
                    {
                        <a class="side-link @(currentPath.StartsWith("/Account/Profile") ? "active" : "")"
                               asp-controller="Account"
                               asp-action="Profile">
                            <i class="bi bi-person-circle"></i>
                            <span>Profile</span>
                        </a>
                    }

                    <a class="side-link @(currentPath.StartsWith("/Account/AuthPreference") ? "active" : "")"
                           asp-controller="Account"
                           asp-action="AuthPreference">
                        <i class="bi bi-shield-lock"></i>
                        <span>Auth Settings</span>
                    </a>
                }
            </nav>
        </aside>

        <section class="app-content">
            <header class="topbar glass-panel">
                <button class="icon-btn d-lg-none" type="button" data-sidebar-toggle>
                    <i class="bi bi-list"></i>
                </button>

                <div>
                    <div class="small text-muted">@DateTime.Now.ToString("dddd, dd MMM yyyy")</div>
                    <strong class="topbar-title">@ViewData["Title"]</strong>
                </div>

                <div class="ms-auto d-flex align-items-center gap-2 gap-md-3">
                    <button class="theme-toggle" type="button" data-theme-toggle title="Switch between Default and Powder Pink theme">
                        <i class="bi bi-heart-pulse-fill"></i>
                        <span class="theme-toggle-copy d-none d-sm-inline">
                            <strong data-theme-toggle-primary>Default</strong>
                            <small data-theme-toggle-secondary>Teal Care</small>
                        </span>
                    </button>

                    @if (isLoggedIn)
                    {
                        <div class="notification-center" data-notifications>
                            <button class="notification-bell" type="button" data-notification-toggle aria-label="Open notifications">
                                <i class="bi bi-bell"></i>
                                <span class="notification-count d-none" data-notification-count>0</span>
                            </button>

                            <div class="notification-menu" data-notification-menu>
                                <div class="notification-menu-header">
                                    <div>
                                        <strong>Notifications</strong>
                                        <small data-notification-subtitle>Latest portal updates</small>
                                    </div>
                                    <button type="button" class="notification-clear" data-notification-clear>Mark read</button>
                                </div>
                                <div class="notification-list" data-notification-list>
                                    <div class="notification-empty">
                                        <i class="bi bi-bell-slash"></i>
                                        <span>No updates yet</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="user-chip">
                            @if (isPatient)
                            {
                                <a class="avatar avatar-clickable"
                                       asp-controller="Account"
                                       asp-action="CompleteProfile"
                                       title="Edit patient photo and profile">
                                    @if (!string.IsNullOrWhiteSpace(photoUrl))
                                    {
                                        <img src="@photoUrl" alt="Profile photo" />
                                    }
                                    else
                                    {
                                        <span>@avatarText</span>
                                    }
                                </a>
                            }
                            else if (isDoctor)
                            {
                                <a class="avatar avatar-clickable"
                                       asp-controller="Doctors"
                                       asp-action="MyProfile"
                                       title="View doctor profile">
                                    @if (!string.IsNullOrWhiteSpace(photoUrl))
                                    {
                                        <img src="@photoUrl" alt="Profile photo" />
                                    }
                                    else
                                    {
                                        <span>@avatarText</span>
                                    }
                                </a>
                            }
                            else
                            {
                                <a class="avatar avatar-clickable"
                                       asp-controller="Account"
                                       asp-action="Profile"
                                       title="View profile">
                                    @if (!string.IsNullOrWhiteSpace(photoUrl))
                                    {
                                        <img src="@photoUrl" alt="Profile photo" />
                                    }
                                    else
                                    {
                                        <span>@avatarText</span>
                                    }
                                </a>
                            }

                            <span class="d-none d-md-block">
                                <strong>@(displayName ?? role)</strong>
                                <small>
                                    @role • @mobileNumber
                                    @if (isPatient && profileCompletion > 0)
                                    {
                                        <text> • @profileCompletion% profile</text>
                                    }
                                </small>
                            </span>
                        </div>

                        <a class="btn btn-danger-soft"
                               asp-controller="Account"
                               asp-action="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                            <span class="d-none d-sm-inline">Logout</span>
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary"
                               asp-controller="Account"
                               asp-action="StaffLogin">
                            Staff Login
                        </a>

                        <a class="btn btn-primary-soft"
                               asp-controller="Account"
                               asp-action="Register">
                            Patient Register
                        </a>

                        <a class="btn btn-primary"
                               asp-controller="Account"
                               asp-action="Login">
                            Patient Login
                        </a>
                    }
                </div>
            </header>

            <main class="app-main fade-in-up">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </section>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
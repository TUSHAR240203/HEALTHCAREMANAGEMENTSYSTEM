@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Patient Dashboard";

    var fullName = Context.Session.GetString("FullName") ?? "Patient";
    var uhid = Context.Session.GetString("UHID") ?? "-";
    var mobileNumber = Context.Session.GetString("MobileNumber") ?? "-";
    var photoUrl = Context.Session.GetString("PhotoUrl");
    var profileCompletion = Context.Session.GetInt32("ProfileCompletion") ?? 15;
}

<div class="container-fluid py-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div>
                            @if (!string.IsNullOrWhiteSpace(photoUrl))
                            {
                                <img src="@photoUrl"
                                     alt="Patient photo"
                                     class="rounded-circle"
                                     style="width:72px;height:72px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                     style="width:72px;height:72px;font-size:28px;font-weight:700;">
                                    @fullName.Substring(0, 1).ToUpper()
                                </div>
                            }
                        </div>

                        <div>
                            <h2 class="mb-1">Welcome, @fullName</h2>
                            <div class="text-muted">
                                UHID: <strong>@uhid</strong> |
                                Mobile: <strong>@mobileNumber</strong>
                            </div>
                        </div>
                    </div>

                    <div>
                        <a asp-controller="Account"
                               asp-action="Profile"
                               class="btn btn-outline-primary">
                            View Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="card-title">Profile Completion</h5>
                    <h2 class="mb-3">@profileCompletion%</h2>

                    <div class="progress mb-3" style="height:10px;">
                        <div class="progress-bar"
                             role="progressbar"
                             style="width:@profileCompletion%;"
                             aria-valuenow="@profileCompletion"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>

                    <a asp-controller="Account"
                           asp-action="CompleteProfile"
                           class="btn btn-primary w-100">
                        Complete / Update Profile
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="card-title">Appointments</h5>
                    <p class="text-muted">Book and manage your appointments.</p>

                    <div class="d-grid gap-2">
                        <a asp-controller="Appointments"
                               asp-action="PatientBook"
                               class="btn btn-primary">
                            Book Appointment
                        </a>

                        <a asp-controller="Appointments"
                               asp-action="ByPatient"
                               class="btn btn-outline-primary">
                            My Appointments
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="card-title">Billing</h5>
                    <p class="text-muted">View bills and payment details.</p>

                    <a asp-controller="Billing"
                           asp-action="ByPatient"
                           class="btn btn-outline-primary w-100">
                        My Bills
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="card-title">Medical Records</h5>
                    <p class="text-muted">Access prescriptions, diagnosis history, and reports.</p>

                    <a asp-controller="MedicalRecords"
                           asp-action="ByPatient"
                           class="btn btn-outline-secondary">
                        View Records
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="card-title">Quick Actions</h5>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Account"
                               asp-action="Profile"
                               class="btn btn-outline-primary">
                            My Profile
                        </a>

                        <a asp-controller="Account"
                               asp-action="CompleteProfile"
                               class="btn btn-outline-primary">
                            Update Details
                        </a>

                        <a asp-controller="Account"
                               asp-action="Logout"
                               class="btn btn-outline-danger">
                            Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
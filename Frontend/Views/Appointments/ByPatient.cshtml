@using Frontend.Models.Api
@model List<AppointmentResponseDto>
@{
    ViewData["Title"] = "My Appointments";
}

<div class="page-header">
    <div>
        <h1>My Appointments</h1>
        <p class="page-subtitle">Track upcoming visits, appointment status, and doctor details.</p>
    </div>
    <a asp-action="PatientBook" class="btn btn-primary"><i class="bi bi-calendar2-plus me-1"></i> Book New Appointment</a>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        @if (Model?.Any() == true)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Appointment</th>
                            <th>Doctor</th>
                            <th>Department</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.OrderByDescending(x => x.AppointmentDate).ThenBy(x => x.SlotStartTime))
                    {
                        <tr>
                            <td><strong>#@item.Id</strong><div class="text-muted small">@item.VisitType</div></td>
                            <td>@item.DoctorName</td>
                            <td>@item.DepartmentName</td>
                            <td>@item.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td>@item.SlotStartTime.ToString("hh\\:mm tt") - @item.SlotEndTime.ToString("hh\\:mm tt")</td>
                            <td><span class="badge badge-@item.StatusCssClass">@item.DisplayStatus</span></td>
                            <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="tile-icon mx-auto mb-3"><i class="bi bi-calendar2-plus"></i></div>
                <h3>No appointments yet</h3>
                <p class="text-muted">Book your first appointment by choosing a doctor and free time slot.</p>
                <a asp-action="PatientBook" class="btn btn-primary">Book Appointment</a>
            </div>
        }
    </div>
</div>

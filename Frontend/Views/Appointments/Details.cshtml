@using Frontend.Models.Api
@model AppointmentDetailsViewModel
@{
    ViewData["Title"] = "Appointment Details";
    var patientName = Model.Patient?.FullName ?? $"Patient #{Model.Appointment.PatientId}";
    var doctorName = Model.Doctor?.FullName ?? Model.Appointment.DoctorName ?? $"Doctor #{Model.Appointment.DoctorId}";
}
<div class="page-header">
    <div>
        <h1>Appointment #@Model.Appointment.Id</h1>
        <p class="page-subtitle">Patient, doctor, slot, status, and actions in one place.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary">Back to Appointments</a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success">@Model.Message</div> }
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="content-card h-100 p-4">
            <div class="doctor-summary">
                @if (!string.IsNullOrWhiteSpace(Model.Patient?.PhotoUrl)) { <img src="@Model.Patient.PhotoUrl" class="avatar-large-img" /> } else { <div class="tile-icon"><i class="bi bi-person"></i></div> }
                <div><small class="text-muted">Patient</small><h2 class="h5 mb-1">@patientName</h2><span>UHID: @Model.Appointment.UHID</span><small>Mobile: @(Model.Patient?.MobileNumber ?? "N/A")</small></div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card h-100 p-4">
            <div class="doctor-summary">
                @if (!string.IsNullOrWhiteSpace(Model.Doctor?.PhotoUrl)) { <img src="@Model.Doctor.PhotoUrl" class="avatar-large-img" /> } else { <div class="tile-icon"><i class="bi bi-heart-pulse"></i></div> }
                <div><small class="text-muted">Doctor</small><h2 class="h5 mb-1">@doctorName</h2><span>@(Model.Doctor?.Specialization ?? "Specialization N/A")</span><small>@Model.Appointment.DepartmentName</small></div>
            </div>
        </div>
    </div>
</div>

<div class="content-card p-4 mb-4">
    <div class="row g-3">
        <div class="col-md-3"><div class="profile-stat"><div class="label">Date</div><div class="value">@Model.Appointment.AppointmentDate.ToString("dd MMM yyyy")</div></div></div>
        <div class="col-md-3"><div class="profile-stat"><div class="label">Time</div><div class="value">@Model.Appointment.SlotStartTime.ToString("hh:mm tt") - @Model.Appointment.SlotEndTime.ToString("hh:mm tt")</div></div></div>
        <div class="col-md-3"><div class="profile-stat"><div class="label">Visit</div><div class="value">@Model.Appointment.VisitType</div></div></div>
        <div class="col-md-3"><div class="profile-stat"><div class="label">Status</div><div class="value">@Model.Appointment.Status</div></div></div>
        <div class="col-12"><strong>Reason:</strong> @(string.IsNullOrWhiteSpace(Model.Appointment.ReasonForVisit) ? "N/A" : Model.Appointment.ReasonForVisit)</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 h-100">
            <div class="card-header"><h2 class="h5 mb-0">Reschedule like seat booking</h2></div>
            <div class="card-body p-4">
                <div class="reschedule-movie-panel mb-3">
                    <strong>@doctorName</strong>
                    <div class="text-muted small">Pick a date, then choose one free slot. Booked slots stay visible but locked.</div>
                </div>
                <form asp-action="Details" method="get" class="mb-3">
                    <input type="hidden" name="id" value="@Model.Appointment.Id" />
                    <label class="form-label">Select date</label>
                    <input name="rescheduleDate" type="date" class="form-control" value="@Model.Reschedule.NewAppointmentDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                </form>
                <form asp-action="Reschedule" asp-route-id="@Model.Appointment.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Reschedule.NewAppointmentDate" type="hidden" value="@Model.Reschedule.NewAppointmentDate.ToString("yyyy-MM-dd")" />
                    <div class="slot-grid mb-3">
                        @foreach (var slot in Model.FreeSlots)
                        {
                            var sid = "rs_" + slot.Value.Replace(":", "").Replace("|", "_");
                            <input type="radio" class="slot-radio" name="SelectedSlot" id="@sid" value="@slot.Value" disabled="@slot.IsBooked" />
                            <label class="slot-pill @(slot.IsBooked ? "booked" : "available")" for="@sid">
                                <i class="bi @(slot.IsBooked ? "bi-lock-fill" : "bi-check-circle")"></i>
                                <span>@slot.Label</span>
                                <small>@(slot.IsBooked ? "Booked" : "Free")</small>
                            </label>
                        }
                    </div>
                    <label asp-for="Reschedule.Reason" class="form-label"></label>
                    <textarea asp-for="Reschedule.Reason" class="form-control mb-3" rows="3" placeholder="Reason for reschedule"></textarea>
                    <button type="submit" class="btn btn-primary w-100">Confirm New Slot</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card border-0 h-100"><div class="card-header"><h2 class="h5 mb-0">Cancel</h2></div><div class="card-body p-4"><form asp-action="Cancel" asp-route-id="@Model.Appointment.Id" method="post">@Html.AntiForgeryToken()<textarea asp-for="Cancel.Reason" class="form-control mb-3" rows="5" placeholder="Reason"></textarea><button class="btn btn-danger w-100">Cancel</button></form></div></div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 h-100"><div class="card-header"><h2 class="h5 mb-0">Complete</h2></div><div class="card-body p-4"><form asp-action="Complete" asp-route-id="@Model.Appointment.Id" method="post">@Html.AntiForgeryToken()<textarea asp-for="Complete.Notes" class="form-control mb-3" rows="5" placeholder="Consultation notes"></textarea><button class="btn btn-success w-100">Mark completed</button></form></div></div>
    </div>
</div>

@model List<AppointmentResponseDto>
@{
    ViewData["Title"] = "Appointments By Doctor";
}

<h1>Appointments By Doctor</h1>
<div class="card">
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Date</th>
                <th>Time</th>
                <th>Patient</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.AppointmentDate.ToString("dd-MMM-yyyy")</td>
                    <td>@item.SlotStartTime - @item.SlotEndTime</td>
                    <td>@item.PatientId / @item.UHID</td>
                    <td>@item.DisplayStatus</td>
                    <td><a asp-action="Details" asp-route-id="@item.Id">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
@using Frontend.Models.ViewModels
@model PatientAppointmentBookingViewModel
@{
    ViewData["Title"] = "Book Appointment";
}

<div class="page-header">
    <div>
        <h1>Book Appointment</h1>
        <p class="page-subtitle">Choose a doctor, pick a free slot, and confirm your visit.</p>
    </div>
    <a asp-action="ByPatient" asp-route-patientId="@Model.PatientId" class="btn btn-outline-primary"><i class="bi bi-calendar-check me-1"></i> My Appointments</a>
</div>

<div class="booking-hero glass-panel">
    <div>
        <span class="badge-soft"><i class="bi bi-clock-history"></i> Live slots</span>
        <h2>Movie-style slot booking</h2>
        <p>Doctor cards show name, speciality, department and photo. Pick one, then choose an available slot.</p>
    </div>
    <div class="booking-patient-card">
        <span>Patient ID</span>
        <strong>#@Model.PatientId</strong>
        <small>UHID: @(string.IsNullOrWhiteSpace(Model.UHID) ? "Not available" : Model.UHID)</small>
    </div>
</div>

<div class="card border-0">
    <div class="card-header"><h2 class="h5 mb-0">Choose doctor and date</h2></div>
    <div class="card-body p-4">
        <form asp-action="PatientBook" method="get" class="row g-3 align-items-end">
            <div class="col-12">
                @if (!Model.Doctors.Any())
                {
                    <div class="empty-state"><h3>No doctors found</h3><p>Add doctors first from the Doctors module.</p></div>
                }
                else
                {
                    <div class="doctor-search-panel">
                        <label class="form-label" for="doctorSearch">Search doctor</label>
                        <div class="doctor-search-box">
                            <i class="bi bi-search"></i>
                            <input id="doctorSearch" class="form-control" type="search" placeholder="Search by doctor name or speciality" autocomplete="off" />
                        </div>
                    </div>
                    <div class="doctor-choice-grid doctor-choice-list" id="doctorChoiceList">
                        @foreach (var doctor in Model.Doctors)
                        {
                            var did = "doctor_" + doctor.Id;
                            var searchText = $"{doctor.FullName} {doctor.Specialization} {doctor.DepartmentName}";
                            <div class="doctor-choice-item" data-doctor-search="@searchText.ToLowerInvariant()">
                                <input type="radio" class="doctor-radio" name="doctorId" id="@did" value="@doctor.Id" checked="@(doctor.Id == Model.DoctorId)" />
                                <label class="doctor-choice-card compact" for="@did">
                                    @if (!string.IsNullOrWhiteSpace(doctor.PhotoUrl)) { <img src="@doctor.PhotoUrl" alt="@doctor.FullName" /> } else { <span class="doctor-avatar-fallback"><i class="bi bi-person-badge"></i></span> }
                                    <span class="doctor-choice-name">@doctor.FullName</span>
                                    <small>.Specialization</small>
                                    <em>.DepartmentName</em>
                                </label>
                            </div>
                        }
                    </div>
                    <div class="empty-state d-none" id="doctorNoResults"><h3>No matching doctor</h3><p>Try another name or speciality.</p></div>
                }
            </div>
            <div class="col-md-8 col-lg-4">
                <label class="form-label">Date</label>
                <input name="appointmentDate" type="date" value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4 col-lg-3">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Check Slots</button>
            </div>
        </form>
    </div>
</div>

<form asp-action="PatientBook" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="PatientId" type="hidden" />
    <input asp-for="UHID" type="hidden" />
    <input asp-for="DoctorId" type="hidden" />
    <input asp-for="AppointmentDate" type="hidden" value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0">
                <div class="card-header">
                    <h2 class="h5 mb-1">Time Slots  (Model.SelectedDoctor != null) { <text>for .SelectedDoctor.FullName</text> }</h2>
                    <p class="text-muted mb-0">Select one available slot for @Model.AppointmentDate.ToString("dd MMM yyyy").</p>
                </div>
                <div class="card-body p-4">
                    @if (!Model.Doctors.Any())
                    {
                        <div class="empty-state"><h3>No doctors found</h3><p>Add doctors first from the Doctors module.</p></div>
                    }
                    else
                    {
                        <div class="slot-grid">
                            @foreach (var slot in Model.Slots)
                            {
                                var id = "slot_" + slot.Value.Replace(":", "").Replace("|", "_");
                                <input type="radio" class="slot-radio" name="SelectedSlot" id="@id" value="@slot.Value" disabled="@slot.IsBooked" checked="@(Model.SelectedSlot == slot.Value)" />
                                <label class="slot-pill @(slot.IsBooked ? "booked" : "available")" for="@id">
                                    <i class="bi @(slot.IsBooked ? "bi-lock-fill" : "bi-check-circle")"></i>
                                    <span>@slot.Label</span>
                                    <small>@(slot.IsBooked ? "Booked" : "Available")</small>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="SelectedSlot" class="text-danger d-block mt-3"></span>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 sticky-summary">
                <div class="card-header"><h2 class="h5 mb-0">Confirm Visit</h2></div>
                <div class="card-body p-4">
                    @if (Model.SelectedDoctor != null)
                    {
                        <div class="doctor-summary mb-3">
                            @if (!string.IsNullOrWhiteSpace(Model.SelectedDoctor.PhotoUrl)) { <img src="@Model.SelectedDoctor.PhotoUrl" class="avatar-sm" /> } else { <div class="tile-icon"><i class="bi bi-person-badge"></i></div> }
                            <div><strong>@Model.SelectedDoctor.FullName</strong><span>@Model.SelectedDoctor.Specialization</span><small>@Model.SelectedDoctor.DepartmentName</small></div>
                        </div>
                    }
                    <div class="mb-3">
                        <label asp-for="VisitType" class="form-label"></label>
                        <select asp-for="VisitType" class="form-select">
                            <option>OPD</option>
                            <option>New Visit</option>
                            <option>Follow-up</option>
                            <option>Emergency</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ReasonForVisit" class="form-label"></label>
                        <textarea asp-for="ReasonForVisit" class="form-control" rows="4" placeholder="Describe symptoms or reason"></textarea>
                    </div>
                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsTeleConsultation" class="form-check-input" />
                        <label asp-for="IsTeleConsultation" class="form-check-label fw-bold"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-calendar2-plus me-1"></i> Book Appointment</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const search = document.getElementById('doctorSearch');
            const list = document.getElementById('doctorChoiceList');
            const noResults = document.getElementById('doctorNoResults');
            const getForm = list?.closest('form');

            search?.addEventListener('input', () => {
                const value = search.value.trim().toLowerCase();
                let visibleCount = 0;
                list?.querySelectorAll('.doctor-choice-item').forEach(item => {
                    const match = item.dataset.doctorSearch.includes(value);
                    item.classList.toggle('d-none', !match);
                    if (match) visibleCount++;
                });
                noResults?.classList.toggle('d-none', visibleCount > 0);
            });

            list?.querySelectorAll('input[name="doctorId"]').forEach(input => {
                input.addEventListener('change', () => {
                    getForm?.classList.add('doctor-switching');
                    window.setTimeout(() => getForm?.submit(), 180);
                });
            });
        })();
    </script>
}

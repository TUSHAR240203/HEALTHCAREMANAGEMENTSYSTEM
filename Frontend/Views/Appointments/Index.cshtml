@using Frontend.Models.ViewModels
@model AppointmentListViewModel
@using Frontend.Models.Api
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Appointments";

    var role = Context.Session.GetString("Role") ?? string.Empty;
    var isAdmin = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);
    var isReception = string.Equals(role, "Receptionist", StringComparison.OrdinalIgnoreCase);
    var isDoctor = string.Equals(role, "Doctor", StringComparison.OrdinalIgnoreCase);

    var currentPage = Model.Search.PageNumber <= 0 ? 1 : Model.Search.PageNumber;
    var pageSize = Model.Search.PageSize <= 0 ? 5 : Model.Search.PageSize;
    var totalCount = Model.Result?.TotalCount ?? 0;
    var totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    var hasPrevious = currentPage > 1;
    var hasNext = currentPage < totalPages;

    var showingFrom = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var showingTo = Math.Min(currentPage * pageSize, totalCount);

    var today = DateOnly.FromDateTime(DateTime.Today);
    var todayCount = Model.Result?.Appointments?.Count(x => x.AppointmentDate == today) ?? 0; var completedCount = Model.Result?.Appointments?.Count(x => x.Status.ToString().Equals("Completed", StringComparison.OrdinalIgnoreCase)) ?? 0;
    var pendingCount = Model.Result?.Appointments?.Count(x =>
        x.Status.ToString().Equals("Pending", StringComparison.OrdinalIgnoreCase) ||
        x.Status.ToString().Equals("Scheduled", StringComparison.OrdinalIgnoreCase)) ?? 0;
}

<div class="appointment-page">
    <section class="appointment-hero">
        <div class="hero-left">
            <span class="hero-kicker">
                <i class="bi bi-stars"></i>
                @(isDoctor ? "Doctor Appointment Workspace" : "Appointment Management")
            </span>

            <h1>@(isDoctor ? "My Appointment Schedule" : "Appointments Dashboard")</h1>

            <p>
                @(isDoctor
                    ? "View assigned consultations, patient visits, timings, and appointment status from one refined dashboard."
                    : "Search, track, and manage hospital appointments with a cleaner professional appointment board.")
            </p>

            <div class="hero-meta">
                <span><i class="bi bi-calendar-check"></i> @DateTime.Today.ToString("dd MMM yyyy")</span>
                <span><i class="bi bi-person-badge"></i> @role</span>
            </div>
        </div>

        <div class="hero-right">
            <div class="metric-card metric-main">
                <span>Total Appointments</span>
                <strong>@totalCount</strong>
                <small>Showing @showingFrom - @showingTo</small>
            </div>

            <div class="metric-grid">
                <div class="metric-card">
                    <span>Today</span>
                    <strong>@todayCount</strong>
                </div>

                <div class="metric-card">
                    <span>Pending</span>
                    <strong>@pendingCount</strong>
                </div>

                <div class="metric-card">
                    <span>Completed</span>
                    <strong>@completedCount</strong>
                </div>
            </div>

            @if (isAdmin || isReception)
            {
                <a asp-action="Create" class="create-appointment-btn">
                    <i class="bi bi-plus-lg"></i>
                    New Appointment
                </a>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="soft-alert soft-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.Message</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="soft-alert soft-alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <section class="filter-card">
        <div class="section-heading">
            <div>
                <span class="section-label">Filters</span>
                <h2>Find appointments faster</h2>
            </div>

            <div class="page-size-pill">
                <i class="bi bi-sliders"></i>
                Page size: 5
            </div>
        </div>

        <form asp-action="Index" method="get" class="filter-grid">
            <div class="filter-control">
                <label asp-for="Search.PatientId">Patient ID</label>
                <div class="field-shell">
                    <i class="bi bi-person"></i>
                    <input asp-for="Search.PatientId" class="form-control" placeholder="Enter patient id" />
                </div>
            </div>

            @if (!isDoctor)
            {
                <div class="filter-control">
                    <label asp-for="Search.DoctorId">Doctor ID</label>
                    <div class="field-shell">
                        <i class="bi bi-heart-pulse"></i>
                        <input asp-for="Search.DoctorId" class="form-control" placeholder="Enter doctor id" />
                    </div>
                </div>
            }

            <div class="filter-control">
                <label asp-for="Search.DepartmentId">Department ID</label>
                <div class="field-shell">
                    <i class="bi bi-building"></i>
                    <input asp-for="Search.DepartmentId" class="form-control" placeholder="Enter department id" />
                </div>
            </div>

            <div class="filter-control">
                <label asp-for="Search.AppointmentDate">Appointment Date</label>
                <div class="field-shell">
                    <i class="bi bi-calendar-event"></i>
                    <input asp-for="Search.AppointmentDate" type="date" class="form-control" />
                </div>
            </div>

            <div class="filter-control">
                <label asp-for="Search.Status">Status</label>
                <div class="field-shell">
                    <i class="bi bi-activity"></i>
                    <select asp-for="Search.Status" asp-items="Html.GetEnumSelectList<AppointmentStatus>()" class="form-select">
                        <option value="">All statuses</option>
                    </select>
                </div>
            </div>

            <input name="PageNumber" type="hidden" value="1" />
            <input name="PageSize" type="hidden" value="5" />

            <div class="filter-buttons">
                <button type="submit" class="primary-action-btn">
                    <i class="bi bi-search"></i>
                    Search
                </button>

                <a asp-action="Index" class="secondary-action-btn">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Reset
                </a>
            </div>
        </form>
    </section>

    <section class="appointment-board">
        <div class="section-heading board-heading">
            <div>
                <span class="section-label">Appointment Board</span>
                <h2>@(isDoctor ? "Assigned visits" : "All appointments")</h2>
            </div>

            <div class="board-summary">
                Page <strong>@currentPage</strong> of <strong>@totalPages</strong>
            </div>
        </div>

        @if (Model.Result?.Appointments?.Any() == true)
        {
            <div class="appointments-timeline">
                @foreach (var item in Model.Result.Appointments)
                {
                    var statusClass = item.Status.ToString().ToLowerInvariant();

                    <article class="appointment-card-pro">
                        <div class="date-panel">
                            <span>@item.AppointmentDate.ToString("MMM")</span>
                            <strong>@item.AppointmentDate.ToString("dd")</strong>
                            <small>@item.AppointmentDate.ToString("yyyy")</small>
                        </div>

                        <div class="card-main">
                            <div class="card-topline">
                                <div>
                                    <span class="appointment-id">Appointment #@item.Id</span>
                                    <h3>
                                        @(string.IsNullOrWhiteSpace(item.DoctorName) ? "Doctor not assigned" : item.DoctorName)
                                    </h3>
                                </div>

                                <span class="status-pill status-@statusClass">
                                    <i class="bi bi-circle-fill"></i>
                                    @item.Status
                                </span>
                            </div>

                            <div class="time-strip">
                                <i class="bi bi-clock-history"></i>
                                <span>@item.SlotStartTime - @item.SlotEndTime</span>
                            </div>

                            <div class="info-grid-pro">
                                <div class="info-box">
                                    <i class="bi bi-person-vcard"></i>
                                    <div>
                                        <span>Patient ID</span>
                                        <strong>@item.PatientId</strong>
                                    </div>
                                </div>

                                <div class="info-box">
                                    <i class="bi bi-credit-card-2-front"></i>
                                    <div>
                                        <span>UHID</span>
                                        <strong>@(string.IsNullOrWhiteSpace(item.UHID) ? "-" : item.UHID)</strong>
                                    </div>
                                </div>

                                <div class="info-box">
                                    <i class="bi bi-building"></i>
                                    <div>
                                        <span>Department</span>
                                        <strong>@(string.IsNullOrWhiteSpace(item.DepartmentName) ? "Not available" : item.DepartmentName)</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="details-btn">
                                <i class="bi bi-eye"></i>
                                View
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-appointments">
                <div class="empty-illustration">
                    <i class="bi bi-calendar2-x"></i>
                </div>

                <h3>No appointments found</h3>
                <p>Try adjusting your filters or reset the search to view available appointments.</p>

                <a asp-action="Index" class="secondary-action-btn">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Clear Filters
                </a>
            </div>
        }

        <div class="pagination-pro">
            <div>
                @if (hasPrevious)
                {
                    <a asp-action="Index" class="page-btn"
                           asp-route-PageNumber="@(currentPage - 1)"
                           asp-route-PageSize="5"
                           asp-route-PatientId="@Model.Search.PatientId"
                           asp-route-DoctorId="@Model.Search.DoctorId"
                           asp-route-DepartmentId="@Model.Search.DepartmentId"
                           asp-route-Status="@Model.Search.Status"
                           asp-route-AppointmentDate="@Model.Search.AppointmentDate">
                        <i class="bi bi-arrow-left"></i>
                        Previous
                    </a>
                }
                else
                {
                    <button type="button" class="page-btn disabled" disabled>
                        <i class="bi bi-arrow-left"></i>
                        Previous
                    </button>
                }
            </div>

            <div class="pagination-status">
                <strong>@currentPage</strong>
                <span>of</span>
                <strong>@totalPages</strong>
                <small>@totalCount appointments</small>
            </div>

            <div>
                @if (hasNext)
                {
                    <a asp-action="Index" class="page-btn next-btn"
                           asp-route-PageNumber="@(currentPage + 1)"
                           asp-route-PageSize="5"
                           asp-route-PatientId="@Model.Search.PatientId"
                           asp-route-DoctorId="@Model.Search.DoctorId"
                           asp-route-DepartmentId="@Model.Search.DepartmentId"
                           asp-route-Status="@Model.Search.Status"
                           asp-route-AppointmentDate="@Model.Search.AppointmentDate">
                        Next
                        <i class="bi bi-arrow-right"></i>
                    </a>
                }
                else
                {
                    <button type="button" class="page-btn disabled" disabled>
                        Next
                        <i class="bi bi-arrow-right"></i>
                    </button>
                }
            </div>
        </div>
    </section>
</div>

<style>
    :root {
        --hms-cyan: #0ea5e9;
        --hms-cyan-dark: #0284c7;
        --hms-teal: #14b8a6;
        --hms-teal-dark: #0f766e;
        --hms-soft: #ecfeff;
        --hms-border: #ccfbf1;
        --hms-text: #0f172a;
        --hms-muted: #64748b;
    }

    .appointment-page {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-bottom: 2rem;
    }

    .appointment-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(320px, .9fr);
        gap: 1.5rem;
        padding: 1.75rem;
        border-radius: 24px;
        background: linear-gradient(135deg, #ffffff 0%, #f0fdfa 45%, #ecfeff 100%);
        color: var(--hms-text);
        border: 1px solid var(--hms-border);
        box-shadow: 0 14px 40px rgba(20, 184, 166, .12);
        overflow: hidden;
        position: relative;
    }

        .appointment-hero::after {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            right: -80px;
            top: -90px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(14, 165, 233, .16), rgba(20, 184, 166, .16));
        }

    .hero-left,
    .hero-right {
        position: relative;
        z-index: 1;
    }

    .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .45rem .8rem;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--hms-cyan), var(--hms-teal));
        color: #ffffff;
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
        margin-bottom: .9rem;
        box-shadow: 0 10px 22px rgba(14, 165, 233, .2);
    }

    .appointment-hero h1 {
        font-size: clamp(1.8rem, 3vw, 2.7rem);
        font-weight: 800;
        line-height: 1.05;
        margin-bottom: .8rem;
        color: var(--hms-text);
    }

    .appointment-hero p {
        max-width: 760px;
        margin: 0;
        color: var(--hms-muted);
        font-size: .98rem;
        line-height: 1.65;
    }

    .hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .65rem;
        margin-top: 1.15rem;
    }

        .hero-meta span {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .5rem .75rem;
            border-radius: 999px;
            background: #ffffff;
            border: 1px solid var(--hms-border);
            color: #334155;
            font-size: .85rem;
            font-weight: 700;
        }

        .hero-meta i,
        .section-label,
        .field-shell i,
        .info-box i {
            color: var(--hms-cyan-dark);
        }

    .hero-right {
        display: flex;
        flex-direction: column;
        gap: .85rem;
    }

    .metric-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: .7rem;
    }

    .metric-card {
        padding: .95rem;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid var(--hms-border);
        box-shadow: 0 10px 25px rgba(20, 184, 166, .08);
    }

        .metric-card span {
            display: block;
            color: var(--hms-muted);
            font-size: .74rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .metric-card strong {
            display: block;
            margin-top: .25rem;
            color: var(--hms-text);
            font-size: 1.55rem;
            line-height: 1;
        }

        .metric-card small {
            color: var(--hms-muted);
            font-weight: 600;
        }

    .metric-main {
        background: linear-gradient(135deg, #ffffff 0%, #ecfeff 100%);
    }

        .metric-main strong {
            font-size: 2.5rem;
            color: var(--hms-teal-dark);
        }

    .create-appointment-btn,
    .primary-action-btn,
    .next-btn {
        background: linear-gradient(135deg, var(--hms-cyan), var(--hms-teal));
        color: #ffffff;
        border: 0;
        box-shadow: 0 12px 24px rgba(14, 165, 233, .18);
    }

    .create-appointment-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: .55rem;
        padding: .85rem 1.1rem;
        border-radius: 16px;
        font-weight: 800;
        text-decoration: none;
        transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
    }

        .create-appointment-btn:hover,
        .primary-action-btn:hover,
        .next-btn:hover,
        .next-btn:focus {
            background: linear-gradient(135deg, var(--hms-cyan-dark), var(--hms-teal-dark));
            color: #ffffff;
            filter: none;
            transform: translateY(-1px);
            box-shadow: 0 16px 30px rgba(20, 184, 166, .25);
        }

    .soft-alert {
        display: flex;
        align-items: center;
        gap: .7rem;
        padding: 1rem 1.2rem;
        border-radius: 16px;
        font-weight: 700;
        border: 1px solid transparent;
    }

    .soft-alert-success {
        color: #0f766e;
        background: #ccfbf1;
        border-color: #99f6e4;
    }

    .soft-alert-danger {
        color: #991b1b;
        background: #fee2e2;
        border-color: #fecaca;
    }

    .filter-card,
    .appointment-board {
        padding: 1.25rem;
        border-radius: 22px;
        background: #ffffff;
        border: 1px solid #dbeafe;
        box-shadow: 0 14px 35px rgba(20, 184, 166, .07);
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.2rem;
    }

    .section-label {
        display: block;
        font-size: .75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .25rem;
    }

    .section-heading h2 {
        margin: 0;
        color: var(--hms-text);
        font-size: 1.25rem;
        font-weight: 800;
    }

    .page-size-pill,
    .board-summary {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .5rem .8rem;
        border-radius: 999px;
        background: var(--hms-soft);
        border: 1px solid var(--hms-border);
        color: var(--hms-teal-dark);
        font-weight: 800;
        font-size: .82rem;
        white-space: nowrap;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(150px, 1fr));
        gap: 1rem;
        align-items: end;
    }

    .filter-control label {
        display: block;
        margin-bottom: .4rem;
        color: #334155;
        font-size: .82rem;
        font-weight: 800;
    }

    .field-shell {
        position: relative;
    }

        .field-shell i {
            position: absolute;
            left: .85rem;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
        }

        .field-shell .form-control,
        .field-shell .form-select {
            min-height: 44px;
            padding-left: 2.4rem;
            border-radius: 14px;
            border: 1px solid #bae6fd;
            background-color: #ffffff;
            font-weight: 600;
            color: var(--hms-text);
            box-shadow: none;
        }

            .field-shell .form-control:focus,
            .field-shell .form-select:focus {
                border-color: var(--hms-teal);
                background-color: #ffffff;
                box-shadow: 0 0 0 .18rem rgba(20, 184, 166, .12);
            }

    .filter-buttons {
        display: flex;
        gap: .65rem;
    }

    .primary-action-btn,
    .secondary-action-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        padding: .65rem 1rem;
        border-radius: 14px;
        font-weight: 800;
        text-decoration: none;
        transition: all .2s ease;
        white-space: nowrap;
    }

    .secondary-action-btn {
        background: #ffffff;
        color: var(--hms-teal-dark);
        border: 1px solid var(--hms-border);
    }

        .secondary-action-btn:hover {
            background: var(--hms-soft);
            color: var(--hms-teal-dark);
            border-color: var(--hms-teal);
        }

    .appointments-timeline {
        display: flex;
        flex-direction: column;
        gap: .9rem;
    }

    .appointment-card-pro {
        display: grid;
        grid-template-columns: 86px minmax(0, 1fr) auto;
        gap: 1rem;
        align-items: stretch;
        padding: .95rem;
        border-radius: 20px;
        border: 1px solid #dbeafe;
        background: #ffffff;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .appointment-card-pro:hover {
            transform: translateY(-2px);
            border-color: var(--hms-teal);
            box-shadow: 0 14px 35px rgba(20, 184, 166, .12);
        }

    .date-panel {
        min-height: 112px;
        border-radius: 16px;
        background: linear-gradient(135deg, #e0f2fe, #ccfbf1);
        border: 1px solid var(--hms-border);
        color: var(--hms-teal-dark);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .date-panel span {
            font-size: .75rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .date-panel strong {
            font-size: 2rem;
            line-height: 1;
            font-weight: 900;
        }

        .date-panel small {
            color: #0f766e;
            font-weight: 800;
        }

    .card-main {
        min-width: 0;
    }

    .card-topline {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-start;
    }

    .appointment-id {
        display: block;
        color: var(--hms-muted);
        font-size: .78rem;
        font-weight: 800;
        margin-bottom: .2rem;
    }

    .card-topline h3 {
        margin: 0;
        color: var(--hms-text);
        font-size: 1.1rem;
        font-weight: 900;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .42rem .7rem;
        border-radius: 999px;
        font-size: .76rem;
        font-weight: 900;
        white-space: nowrap;
    }

        .status-pill i {
            font-size: .45rem;
        }

    .status-scheduled,
    .status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .status-confirmed,
    .status-approved {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-completed {
        background: #ccfbf1;
        color: #0f766e;
    }

    .status-cancelled,
    .status-canceled {
        background: #fee2e2;
        color: #991b1b;
    }

    .time-strip {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        margin-top: .75rem;
        padding: .42rem .7rem;
        border-radius: 999px;
        background: var(--hms-soft);
        border: 1px solid var(--hms-border);
        color: #334155;
        font-size: .83rem;
        font-weight: 800;
    }

    .info-grid-pro {
        display: grid;
        grid-template-columns: repeat(3, minmax(130px, 1fr));
        gap: .7rem;
        margin-top: .9rem;
    }

    .info-box {
        display: flex;
        gap: .6rem;
        align-items: center;
        padding: .7rem;
        border-radius: 16px;
        background: #ffffff;
        border: 1px solid #dbeafe;
    }

        .info-box i {
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: var(--hms-soft);
        }

        .info-box span {
            display: block;
            color: var(--hms-muted);
            font-size: .7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .info-box strong {
            display: block;
            color: var(--hms-text);
            font-size: .88rem;
            font-weight: 900;

@model Frontend.Models.Billing.PaymentRequestDto
@{
    ViewData["Title"] = "Add Payment";
}

<div class="page-header">
    <div>
        <h1>Add Payment</h1>
        <p class="page-subtitle">Record a payment entry for invoice #@ViewBag.InvoiceId.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0">
            <div class="card-body p-4">
                <form asp-action="AddPayment" asp-route-invoiceId="@ViewBag.InvoiceId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount" class="form-control" placeholder="Payment amount" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="PaymentMode" class="form-label"></label>
                        <input asp-for="PaymentMode" class="form-control" placeholder="Cash / Card / UPI / Insurance" />
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-success">Save Payment</button>
                        <a asp-action="Details" asp-route-invoiceId="@ViewBag.InvoiceId" class="btn btn-outline-secondary">Back to Invoice</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model Frontend.Models.Billing.InvoiceResponseDto
@{
    ViewData["Title"] = "Invoice Details";
}

<div class="page-header">
    <div>
        <h1>Invoice Details</h1>
        <p class="page-subtitle">Review invoice totals, line items, and payment history for invoice #@Model.Id.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="AddItem" asp-route-invoiceId="@Model.Id" class="btn btn-light text-primary">Add Item</a>
        <a asp-action="AddPayment" asp-route-invoiceId="@Model.Id" class="btn btn-outline-light">Add Payment</a>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-4">
        <div class="info-grid">
            <div class="info-card"><span class="info-label">Invoice Id</span><span class="info-value">@Model.Id</span></div>
            <div class="info-card"><span class="info-label">Patient Id</span><span class="info-value">@Model.PatientId</span></div>
            <div class="info-card"><span class="info-label">UHID</span><span class="info-value">@Model.UHID</span></div>
            <div class="info-card"><span class="info-label">Appointment Id</span><span class="info-value">@Model.AppointmentId</span></div>
            <div class="info-card"><span class="info-label">Total Amount</span><span class="info-value">@Model.TotalAmount</span></div>
            <div class="info-card"><span class="info-label">Paid Amount</span><span class="info-value">@Model.PaidAmount</span></div>
            <div class="info-card"><span class="info-label">Balance Amount</span><span class="info-value">@Model.BalanceAmount</span></div>
            <div class="info-card"><span class="info-label">Status</span><span class="info-value">@Model.Status</span></div>
            <div class="info-card"><span class="info-label">Created At (UTC)</span><span class="info-value">@Model.CreatedAtUtc</span></div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 h-100">
            <div class="card-header"><h3 class="h5 mb-1">Invoice Items</h3><p class="section-subtitle">Services added to this invoice</p></div>
            <div class="card-body p-0">
                @if (Model.Items != null && Model.Items.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead><tr><th>Id</th><th>Service Name</th><th>Price</th><th>Qty</th><th>Amount</th></tr></thead>
                            <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr><td>@item.Id</td><td>@item.ServiceName</td><td>₹@item.Price</td><td>@item.Quantity</td><td>₹@item.Amount</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4"><div class="alert alert-warning mb-0">No invoice items found.</div></div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 h-100">
            <div class="card-header"><h3 class="h5 mb-1">Payments</h3><p class="section-subtitle">Transactions received against this invoice</p></div>
            <div class="card-body p-0">
                @if (Model.Payments != null && Model.Payments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead><tr><th>Id</th><th>Amount</th><th>Payment Mode</th><th>Paid At (UTC)</th></tr></thead>
                            <tbody>
                            @foreach (var payment in Model.Payments)
                            {
                                <tr><td>@payment.Id</td><td>₹@payment.Amount</td><td>@payment.PaymentMethod</td><td>@payment.PaidAtUtc</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4"><div class="alert alert-warning mb-0">No payments found.</div></div>
                }
            </div>
        </div>
    </div>
</div>

@model Frontend.Models.Billing.CreateInvoiceRequestDto
@{
    ViewData["Title"] = "Create Invoice";
}

<div class="page-header">
    <div>
        <h1>Create Invoice</h1>
        <p class="page-subtitle">Generate a billing record while keeping all existing backend integrations intact.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-9">
        <div class="card border-0">
            <div class="card-body p-4 p-lg-5">
                <form asp-action="CreateInvoice" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="PatientId" class="form-label"></label>
                            <input asp-for="PatientId" class="form-control" placeholder="Enter patient id" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UHID" class="form-label"></label>
                            <input asp-for="UHID" class="form-control" placeholder="Enter UHID" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AppointmentId" class="form-label"></label>
                            <input asp-for="AppointmentId" class="form-control" placeholder="Linked appointment id" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConsultationFee" class="form-label"></label>
                            <input asp-for="ConsultationFee" class="form-control" placeholder="Consultation fee" />
                        </div>
                    </div>
                    <div class="mt-4 d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">Create Invoice</button>
                        <a asp-action="ByPatient" class="btn btn-outline-secondary">View Patient Invoices</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

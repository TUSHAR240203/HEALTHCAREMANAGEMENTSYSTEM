@model Frontend.Models.Billing.AddInvoiceItemRequestDto
@{
    ViewData["Title"] = "Add Invoice Item";
}

<div class="page-header billing-header">
    <div>
        <span class="badge-soft"><i class="bi bi-receipt"></i> Reception billing</span>
        <h1>Add Invoice Item</h1>
        <p class="page-subtitle">Attach an additional service line to invoice #@ViewBag.InvoiceId using the same service list as Create Invoice, or add a custom item.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0">
            <div class="card-header">
                <h2 class="h5 mb-1">Service Details</h2>
                <p class="section-subtitle mb-0">Choose a predefined service to auto-fill price and quantity, or select Custom Item.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="AddItem" asp-route-invoiceId="@ViewBag.InvoiceId" method="post" id="addInvoiceItemForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label for="serviceSelect" class="form-label">Select Service</label>
                        <select id="serviceSelect" class="form-select">
                            <option value="">-- Select item --</option>
                            <option value="CBC Blood Test" data-price="350">CBC Blood Test - ₹350</option>
                            <option value="Blood Sugar Test" data-price="180">Blood Sugar Test - ₹180</option>
                            <option value="Lipid Profile" data-price="800">Lipid Profile - ₹800</option>
                            <option value="Liver Function Test" data-price="900">Liver Function Test - ₹900</option>
                            <option value="Kidney Function Test" data-price="850">Kidney Function Test - ₹850</option>
                            <option value="Thyroid Profile" data-price="700">Thyroid Profile - ₹700</option>
                            <option value="Urine Routine" data-price="250">Urine Routine - ₹250</option>
                            <option value="ECG" data-price="500">ECG - ₹500</option>
                            <option value="X-Ray" data-price="700">X-Ray - ₹700</option>
                            <option value="Ultrasound" data-price="1500">Ultrasound - ₹1500</option>
                            <option value="Dressing" data-price="300">Dressing - ₹300</option>
                            <option value="Injection Service" data-price="150">Injection Service - ₹150</option>
                            <option value="__custom" data-price="">Custom Item</option>
                        </select>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ServiceName" class="form-label">Service Name</label>
                            <input asp-for="ServiceName" class="form-control" placeholder="Ex. Lab test / Scan / Pharmacy" data-service-name />
                            <span asp-validation-for="ServiceName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Price" class="form-label">Price</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="Price" class="form-control" type="number" min="0" step="0.01" placeholder="0.00" data-item-price />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Quantity" class="form-label">Quantity</label>
                            <input asp-for="Quantity" class="form-control" type="number" min="1" step="1" data-qty />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="invoice-total-card mt-4 p-3">
                        <span>Line Amount</span>
                        <strong id="lineAmount">₹0.00</strong>
                        <small>Price × quantity</small>
                    </div>

                    <div class="d-flex gap-2 flex-wrap mt-4">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Item</button>
                        <a asp-action="Details" asp-route-invoiceId="@ViewBag.InvoiceId" class="btn btn-outline-secondary">Back to Invoice</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const select = document.getElementById('serviceSelect');
            const serviceName = document.querySelector('[data-service-name]');
            const price = document.querySelector('[data-item-price]');
            const qty = document.querySelector('[data-qty]');
            const amount = document.getElementById('lineAmount');
            const money = value => '₹' + (Number(value || 0)).toFixed(2);

            function refreshAmount() {
                amount.textContent = money(Number(price.value || 0) * Number(qty.value || 1));
            }

            select?.addEventListener('change', () => {
                const option = select.selectedOptions[0];
                if (!option || !option.value) return;

                if (option.value === '__custom') {
                    serviceName.value = '';
                    price.value = '';
                    serviceName.removeAttribute('readonly');
                    price.removeAttribute('readonly');
                    serviceName.focus();
                } else {
                    serviceName.value = option.value;
                    price.value = option.dataset.price || '';
                    serviceName.setAttribute('readonly', 'readonly');
                    price.setAttribute('readonly', 'readonly');
                }

                if (!qty.value || Number(qty.value) < 1) qty.value = 1;
                refreshAmount();
            });

            document.addEventListener('input', e => {
                if (e.target.matches('[data-item-price], [data-qty]')) refreshAmount();
                if (e.target.matches('[data-service-name]') && select.value !== '__custom') select.value = '__custom';
            });

            refreshAmount();
        })();
    </script>
}

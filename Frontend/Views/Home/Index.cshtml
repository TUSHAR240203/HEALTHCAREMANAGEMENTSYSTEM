@{
    ViewData["Title"] = "HMS Portal";
}

<div class="hero-panel mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="badge bg-light text-primary mb-3">Healthcare Operations</span>
            <h1 class="display-5 fw-bold mb-3">Hospital Management Portal</h1>
            <p class="lead mb-4">A cleaner Bootstrap-based dashboard for patient onboarding, appointments, billing, and reception workflows.</p>
            <div class="d-flex flex-wrap gap-3 quick-links">
                <a asp-controller="Account" asp-action="ActivatePortal" class="btn btn-light text-primary">Activate Patient Portal</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light">Patient Login</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="row g-3">
                <div class="col-6"><div class="stat-card"><span class="stat-label">Patient Access</span><span class="stat-value">OTP</span></div></div>
                <div class="col-6"><div class="stat-card"><span class="stat-label">Appointments</span><span class="stat-value">Live</span></div></div>
                <div class="col-6"><div class="stat-card"><span class="stat-label">Billing</span><span class="stat-value">Smart</span></div></div>
                <div class="col-6"><div class="stat-card"><span class="stat-label">Reception</span><span class="stat-value">Fast</span></div></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="dashboard-tile">
            <div class="tile-icon mb-3"><i class="bi bi-person-plus"></i></div>
            <h3 class="h5">Portal Activation</h3>
            <p class="text-muted">Send activation OTPs for patients whose portal access is enabled in the Patients API.</p>
            <a asp-controller="Account" asp-action="ActivatePortal" class="btn btn-primary">Open Activation</a>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="dashboard-tile">
            <div class="tile-icon mb-3"><i class="bi bi-box-arrow-in-right"></i></div>
            <h3 class="h5">Patient Login</h3>
            <p class="text-muted">Verify patient login using OTP and create a session-backed portal experience.</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Go to Login</a>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="dashboard-tile">
            <div class="tile-icon mb-3"><i class="bi bi-person-badge"></i></div>
            <h3 class="h5">My Profile</h3>
            <p class="text-muted">Review the patient-linked user account returned from the Auth API /me endpoint.</p>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary">View Profile</a>
        </div>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4 align-items-start">
            <div class="col-lg-6">
                <h2 class="h4 mb-3">Before testing login or activation</h2>
                <ul class="list-group list-group-flush rounded-4 overflow-hidden border">
                    <li class="list-group-item py-3"><i class="bi bi-check-circle text-success me-2"></i>Start <strong>HealthcareGateway</strong> on <code>https://localhost:7000</code>.</li>
                    <li class="list-group-item py-3"><i class="bi bi-check-circle text-success me-2"></i>Start <strong>Hms.AuthApi</strong> and <strong>Hms.PatientsApi</strong>.</li>
                    <li class="list-group-item py-3"><i class="bi bi-check-circle text-success me-2"></i>Use a patient whose <strong>PortalAccessEnabled</strong> flag is true.</li>
                    <li class="list-group-item py-3"><i class="bi bi-check-circle text-success me-2"></i>Read the OTP from the Auth API console output in development.</li>
                </ul>
            </div>
            <div class="col-lg-6">
                <h2 class="h4 mb-3">Other modules in this MVC app</h2>
                <div class="d-grid gap-3">
                    <a asp-controller="Patients" asp-action="Index" class="btn btn-outline-secondary btn-lg text-start"><i class="bi bi-people me-2"></i>Patients management</a>
                    <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-secondary btn-lg text-start"><i class="bi bi-calendar2-week me-2"></i>Appointments</a>
                    <a asp-controller="Reception" asp-action="SearchPatients" class="btn btn-outline-secondary btn-lg text-start"><i class="bi bi-front me-2"></i>Reception</a>
                    <a asp-controller="Billing" asp-action="ByPatient" class="btn btn-outline-secondary btn-lg text-start"><i class="bi bi-receipt me-2"></i>Billing</a>
                </div>
            </div>
        </div>
    </div>
</div>

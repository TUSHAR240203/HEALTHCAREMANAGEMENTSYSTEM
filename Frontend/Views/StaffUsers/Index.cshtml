@model List<Frontend.Models.Admin.StaffUserResponseDto>
@{
    ViewData["Title"] = "Staff Users";
}
<div class="page-header hero-panel mb-4">
    <div>
        <span class="badge-soft mb-3"><i class="bi bi-person-gear"></i> Admin portal</span>
        <h1 class="h2 fw-bold">Staff user management</h1>
        <p class="mb-0">Create and control Admin and Receptionist login accounts.</p>
    </div>
    <a asp-action="Create" class="btn btn-light text-primary"><i class="bi bi-plus-circle me-2"></i>Create user</a>
</div>
<div class="content-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Login ID</th>
                    <th>Role</th>
                    <th>Mobile</th>
                    <th>Email</th>
                    <th>Auth</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-5">No Admin or Receptionist users returned from Auth API.</td></tr>
            }
            @foreach (var user in Model)
            {
                var displayName = string.IsNullOrWhiteSpace(user.FullName) ? user.LoginId : user.FullName;
                <tr>
                    <td class="fw-bold">@displayName</td>
                    <td>@user.LoginId</td>
                    <td><span class="badge badge-scheduled">@user.Role</span></td>
                    <td>@user.MobileNumber</td>
                    <td>@(string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email)</td>
                    <td>
                        @if (user.IsOtpLoginEnabled) { <span class="badge badge-checkedin me-1">OTP</span> }
                        @if (user.IsPasswordLoginEnabled) { <span class="badge badge-booked">JWT</span> }
                    </td>
                    <td><span class="badge @(user.IsActive ? "badge-active" : "badge-inactive")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end">
                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.UserId" />
                            <input type="hidden" name="isActive" value="@(!user.IsActive)" />
                            <button class="btn btn-outline-primary btn-sm" type="submit">@(user.IsActive ? "Deactivate" : "Activate")</button>
                        </form>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this user?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.UserId" />
                            <button class="btn btn-danger-soft btn-sm" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

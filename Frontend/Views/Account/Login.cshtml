@model Frontend.Models.Auth.PatientLoginViewModel
@{
    ViewData["Title"] = "Patient Login";
}
<div class="auth-shell">
    <div class="container-fluid px-0">
        <div class="row justify-content-center">
            <div class="col-xxl-9">
                <div class="auth-card">
                    <div class="row g-0">
                        <div class="col-lg-5">
                            <div class="auth-aside">
                                <span class="badge-soft mb-3"><i class="bi bi-phone"></i> Patient OTP access</span>
                                <h1 class="h2 fw-bold mb-3">Patient portal login</h1>
                                <p class="text-white-50">No activation verification. Registered patients login directly using Patient ID, mobile number and OTP.</p>
                                <ul class="step-list">
                                    <li><span class="step-bullet">1</span><div><strong>Enter patient ID</strong><div class="text-white-50">Use ID from Patients API.</div></div></li>
                                    <li><span class="step-bullet">2</span><div><strong>Send OTP</strong><div class="text-white-50">OTP is printed in Auth API console for testing.</div></div></li>
                                    <li><span class="step-bullet">3</span><div><strong>Login</strong><div class="text-white-50">Complete profile and access portal.</div></div></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="auth-form-panel">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                                    <div><h2 class="mb-1">Patient login</h2><p class="text-muted mb-0">Secure OTP sign in for patient portal.</p></div>
                                    <div class="d-flex gap-2 flex-wrap"><a asp-action="Register" class="btn btn-primary-soft"><i class="bi bi-person-plus me-1"></i> Register Patient</a><a asp-action="StaffLogin" class="btn btn-outline-primary"><i class="bi bi-person-badge me-1"></i> Staff Login</a></div>
                                </div>
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                                <form asp-action="Login" method="post" class="row g-3">
                                    @Html.AntiForgeryToken()
                                    <div class="col-md-6">
                                        <label asp-for="PatientId" class="form-label"></label>
                                        <input asp-for="PatientId" class="form-control" placeholder="Example: 1" />
                                        <span asp-validation-for="PatientId" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="MobileNumber" class="form-label"></label>
                                        <input asp-for="MobileNumber" class="form-control" placeholder="Registered mobile" />
                                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                                    </div>
                                    @if (Model.OtpSent)
                                    {
                                        <div class="col-12">
                                            <label asp-for="OtpCode" class="form-label"></label>
                                            <input asp-for="OtpCode" class="form-control" placeholder="Enter OTP" />
                                            <span asp-validation-for="OtpCode" class="text-danger small"></span>
                                        </div>
                                        <div class="col-12 d-grid d-sm-flex gap-2">
                                            <button type="submit" name="submitButton" value="verifyOtp" class="btn btn-primary flex-fill">Verify OTP & Login</button>
                                            <button type="submit" name="submitButton" value="sendOtp" class="btn btn-outline-primary">Resend OTP</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-12 d-grid">
                                            <button type="submit" name="submitButton" value="sendOtp" class="btn btn-primary btn-lg"><i class="bi bi-send-check me-2"></i>Send Login OTP</button>
                                        </div>
                                    }
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

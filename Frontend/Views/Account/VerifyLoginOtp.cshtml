@model Frontend.Models.Auth.PatientLoginViewModel
@{
    ViewData["Title"] = "Verify Login OTP";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4">
                    <h2 class="mb-3">Verify OTP</h2>
                    <p class="text-muted">Enter the OTP generated by the Auth API.</p>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <form asp-action="VerifyLoginOtp" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="PatientId" class="form-label"></label>
                            <input asp-for="PatientId" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="MobileNumber" class="form-label"></label>
                            <input asp-for="MobileNumber" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="OtpCode" class="form-label"></label>
                            <input asp-for="OtpCode" class="form-control" placeholder="Enter OTP here" />
                            <span asp-validation-for="OtpCode" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Proceed</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
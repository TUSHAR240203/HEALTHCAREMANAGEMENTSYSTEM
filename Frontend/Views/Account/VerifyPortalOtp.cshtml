@model Frontend.Models.Auth.PortalActivationViewModel
@{
    ViewData["Title"] = "Verify Portal OTP";
}

<div class="auth-shell">
    <div class="container py-4 py-lg-5">
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="card auth-card">
                    <div class="row g-0">
                        <div class="col-lg-5">
                            <div class="auth-aside">
                                <span class="badge-soft mb-3"><i class="bi bi-patch-check"></i> Activation verification</span>
                                <h1 class="h2 fw-bold mb-3">Confirm your OTP</h1>
                                <p class="mb-0 text-white-50">Enter the OTP generated by the Auth API to complete portal activation and create the patient session.</p>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="auth-form-panel">
                                <h2 class="mb-1">Verify activation code</h2>
                                <p class="text-muted mb-4">Review the patient details and submit the OTP.</p>

                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                <form asp-action="VerifyPortalOtp" method="post" class="row g-3">
                                    @Html.AntiForgeryToken()

                                    <div class="col-md-6">
                                        <label asp-for="PatientId" class="form-label"></label>
                                        <input asp-for="PatientId" class="form-control" readonly />
                                        <span asp-validation-for="PatientId" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="MobileNumber" class="form-label"></label>
                                        <input asp-for="MobileNumber" class="form-control" />
                                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="OtpCode" class="form-label"></label>
                                        <input asp-for="OtpCode" class="form-control" placeholder="Enter OTP" />
                                        <span asp-validation-for="OtpCode" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12 d-grid d-sm-flex gap-2">
                                        <button type="submit" class="btn btn-success btn-lg flex-fill">
                                            <i class="bi bi-check2-circle me-1"></i> Verify OTP &amp; Activate
                                        </button>
                                        <a asp-action="ActivatePortal" class="btn btn-outline-secondary btn-lg">Back</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

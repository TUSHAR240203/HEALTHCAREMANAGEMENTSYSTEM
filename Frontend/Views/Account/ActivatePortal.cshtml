@model Hms.Web.Models.Auth.PortalActivationViewModel
@{
    ViewData["Title"] = "Verify Portal OTP";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <h2 class="mb-3">Verify Portal OTP</h2>
                    <p class="text-muted">Enter the OTP to activate the patient portal.</p>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <form asp-action="VerifyPortalOtp" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="PatientId" class="form-label"></label>
                            <input asp-for="PatientId" class="form-control form-control-lg" readonly />
                            <span asp-validation-for="PatientId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MobileNumber" class="form-label"></label>
                            <input asp-for="MobileNumber" class="form-control form-control-lg" />
                            <span asp-validation-for="MobileNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OtpCode" class="form-label"></label>
                            <input asp-for="OtpCode" class="form-control form-control-lg" placeholder="Enter OTP here" />
                            <span asp-validation-for="OtpCode" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100">Verify OTP & Activate</button>
                    </form>

                    <div class="mt-3 text-center">
                        <a asp-action="ActivatePortal">Back to Activation</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
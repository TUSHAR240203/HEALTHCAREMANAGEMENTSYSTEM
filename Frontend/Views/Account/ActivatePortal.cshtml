@model Hms.Web.Models.Auth.PortalActivationViewModel
@{
        ViewData["Title"] = "Activate Patient Portal";
}

<div class="auth-shell">
    <div class="container py-4 py-lg-5">
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="card auth-card">
                    <div class="row g-0">
                        <div class="col-lg-5">
                            <div class="auth-aside">
                                <span class="badge-soft mb-3"><i class="bi bi-phone"></i> OTP activation</span>
                                <h1 class="h2 fw-bold mb-3">Activate the patient portal</h1>
                                <p class="mb-0 text-white-50">This flow sends a portal activation OTP for a patient whose portal access has already been enabled in the backend.</p>

                                <ul class="step-list">
                                    <li>
                                        <span class="step-bullet">1</span>
                                        <div><strong>Enter patient info</strong><div class="text-white-50">Use the exact patient ID and mobile number from the patient record.</div></div>
                                    </li>
                                    <li>
                                        <span class="step-bullet">2</span>
                                        <div><strong>Check the Auth API console</strong><div class="text-white-50">In development, the OTP is printed there for quick testing.</div></div>
                                    </li>
                                    <li>
                                        <span class="step-bullet">3</span>
                                        <div><strong>Verify OTP</strong><div class="text-white-50">Successful verification links the patient to a user account and signs them in.</div></div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="auth-form-panel">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                                    <div>
                                        <h2 class="mb-1">Portal activation</h2>
                                        <p class="text-muted mb-0">Start the activation flow for a patient.</p>
                                    </div>
                                    <a asp-action="Login" class="btn btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Go to login
                                    </a>
                                </div>

                                <div class="info-strip mb-4">
                                    <div class="fw-semibold mb-1">Important</div>
                                    <div class="text-muted small">The backend only sends the activation OTP if the patient exists and <strong>PortalAccessEnabled = true</strong>.</div>
                                </div>

                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                <form asp-action="ActivatePortal" method="post" class="row g-3">
                                    @Html.AntiForgeryToken()

                                    <div class="col-md-6">
                                        <label asp-for="PatientId" class="form-label"></label>
                                        <input asp-for="PatientId" class="form-control" placeholder="Enter patient ID" />
                                        <span asp-validation-for="PatientId" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="MobileNumber" class="form-label"></label>
                                        <input asp-for="MobileNumber" class="form-control" placeholder="Enter registered mobile number" />
                                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12 d-grid">
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="bi bi-send-check me-1"></i> Send Activation OTP
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

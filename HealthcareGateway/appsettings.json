{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/gateway/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/gateway/auth"
          },
          {
            "PathPrefix": "/api/auth"
          }
        ]
      },
      "patient-route": {
        "ClusterId": "patient-cluster",
        "Match": {
          "Path": "/gateway/patients/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/gateway/patients"
          },
          {
            "PathPrefix": "/api/patients"
          }
        ]
      },
      "doctor-route": {
        "ClusterId": "doctor-cluster",
        "Match": {
          "Path": "/gateway/doctors/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/gateway/doctors"
          },
          {
            "PathPrefix": "/api/doctors"
          }
        ]
      },
      "appointment-route": {
        "ClusterId": "appointment-cluster",
        "Match": {
          "Path": "/gateway/appointments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/gateway/appointments"
          },
          {
            "PathPrefix": "/api/appointments"
          }
        ]
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/gateway/billing/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/gateway/billing"
          },
          {
            "PathPrefix": "/api/billing"
          }
        ]
      },
      "finance-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/gateway/finance/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/gateway/finance"
          },
          {
            "PathPrefix": "/api/v1/finance"
          }
        ]
      },
      "reception-route": {
        "ClusterId": "reception-cluster",
        "Match": {
          "Path": "/gateway/reception/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/gateway/reception"
          },
          {
            "PathPrefix": "/api/reception"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7003/"
          }
        }
      },
      "patient-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7001/"
          }
        }
      },
      "doctor-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7006/"
          }
        }
      },
      "appointment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7002/"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7005/"
          }
        }
      },
      "reception-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7004/"
          }
        }
      }
    }
  }
}
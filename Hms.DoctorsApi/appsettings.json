{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/doctors-api-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\sqlexpress;Database=Doctors-Healthcare;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "ServiceUrls": {
    "AppointmentsApi": "https://localhost:7002/",
    "ReceptionApi": "https://localhost:7004/"
  },
  "Jwt": {
    "Issuer": "Hms.AuthApi",
    "Audience": "Hms.Clients",
    "Key": "THIS_IS_A_VERY_LONG_SECRET_KEY_123456789_ABCDEF",
    "AccessTokenExpiryMinutes": "30"
  }
}
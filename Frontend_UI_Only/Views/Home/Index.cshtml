@{
    ViewData["Title"] = "HMS Portal";
}

<div class="hero-panel mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="badge bg-light text-primary mb-3">Healthcare Operations</span>
            <h1 class="display-5 fw-bold mb-3">Hospital Management Portal</h1>
            <p class="lead mb-4">A polished, role-ready interface for patient onboarding, appointments, billing, and reception workflows.</p>
            <div class="d-flex flex-wrap gap-3 quick-links">
                <a asp-controller="Account" asp-action="ActivatePortal" class="btn btn-light text-primary">Activate Patient Portal</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light">Patient Login</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="row g-3">
                <div class="col-6"><div class="stat-card"><span class="stat-label">Patient Access</span><span class="stat-value">OTP</span></div></div>
                <div class="col-6"><div class="stat-card"><span class="stat-label">Appointments</span><span class="stat-value">Live</span></div></div>
                <div class="col-6"><div class="stat-card"><span class="stat-label">Billing</span><span class="stat-value">Smart</span></div></div>
                <div class="col-6"><div class="stat-card"><span class="stat-label">Reception</span><span class="stat-value">Fast</span></div></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100 border-0">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="brand-mark"><i class="bi bi-person-plus"></i></div>
                    <div>
                        <h3 class="h5 mb-1">Portal Activation</h3>
                        <p class="section-subtitle">First-time patient access</p>
                    </div>
                </div>
                <p class="text-muted">Start secure OTP-based portal activation for new patients in a guided flow.</p>
                <a asp-controller="Account" asp-action="ActivatePortal" class="btn btn-primary">Open Activation</a>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100 border-0">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="brand-mark"><i class="bi bi-calendar2-check"></i></div>
                    <div>
                        <h3 class="h5 mb-1">Appointments</h3>
                        <p class="section-subtitle">Scheduling and tracking</p>
                    </div>
                </div>
                <p class="text-muted">Manage appointment search, creation, details, and workflow actions from one place.</p>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-primary">View Appointments</a>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100 border-0">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="brand-mark"><i class="bi bi-receipt-cutoff"></i></div>
                    <div>
                        <h3 class="h5 mb-1">Billing & Reception</h3>
                        <p class="section-subtitle">Operational efficiency</p>
                    </div>
                </div>
                <p class="text-muted">Access patient search, check-in, queue support, invoice creation, and payment capture tools.</p>
                <a asp-controller="Billing" asp-action="ByPatient" class="btn btn-outline-primary">Open Billing</a>
            </div>
        </div>
    </div>
</div>

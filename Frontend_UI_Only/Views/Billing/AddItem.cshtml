@model Frontend.Models.Billing.AddInvoiceItemRequestDto
@{
    ViewData["Title"] = "Add Invoice Item";
}

<div class="page-header">
    <div>
        <h1>Add Invoice Item</h1>
        <p class="page-subtitle">Attach an additional service line to invoice #@ViewBag.InvoiceId.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0">
            <div class="card-body p-4">
                <form asp-action="AddItem" asp-route-invoiceId="@ViewBag.InvoiceId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="ServiceName" class="form-label"></label>
                        <input asp-for="ServiceName" class="form-control" placeholder="Ex. Lab test / Scan / Pharmacy" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount" class="form-control" placeholder="Amount" />
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary">Add Item</button>
                        <a asp-action="Details" asp-route-invoiceId="@ViewBag.InvoiceId" class="btn btn-outline-secondary">Back to Invoice</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model Frontend.Models.Reception.DepartmentQueueResponseDto
@{
    ViewData["Title"] = "Department Queue";
}

<div class="page-header">
    <div>
        <h1>Department Queue</h1>
        <p class="page-subtitle">Monitor current queue movement and patient sequence by department.</p>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        @if (Model == null)
        {
            <div class="p-4"><div class="alert alert-warning mb-0">No queue data found.</div></div>
        }
        else
        {
            <div class="p-4 border-bottom">
                <div class="info-grid">
                    <div class="info-card"><span class="info-label">Department</span><span class="info-value">@Model.DepartmentName</span></div>
                    <div class="info-card"><span class="info-label">Date</span><span class="info-value">@Model.Date</span></div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Token</th>
                            <th>Patient Id</th>
                            <th>UHID</th>
                            <th>Name</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Queue)
                    {
                        <tr>
                            <td>@item.TokenNumber</td>
                            <td>@item.PatientId</td>
                            <td>@item.UHID</td>
                            <td>@item.PatientName</td>
                            <td><span class="badge bg-light text-dark">@item.Status</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

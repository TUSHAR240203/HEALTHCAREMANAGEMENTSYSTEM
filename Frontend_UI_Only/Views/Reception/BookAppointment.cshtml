@model Frontend.Models.Reception.BookAppointmentRequestDto
@{
    ViewData["Title"] = "Book Appointment";
}

<div class="page-header">
    <div>
        <h1>Book Appointment</h1>
        <p class="page-subtitle">Capture visit details, slot timing, and consultation mode in one structured view.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card border-0">
            <div class="card-body p-4 p-lg-5">
                <form asp-action="BookAppointment" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-4"><label asp-for="PatientId" class="form-label"></label><input asp-for="PatientId" class="form-control" /></div>
                        <div class="col-md-4"><label asp-for="DoctorId" class="form-label"></label><input asp-for="DoctorId" class="form-control" /></div>
                        <div class="col-md-4"><label asp-for="DepartmentId" class="form-label"></label><input asp-for="DepartmentId" class="form-control" /></div>
                        <div class="col-md-4"><label asp-for="AppointmentDate" class="form-label"></label><input asp-for="AppointmentDate" type="date" class="form-control" /></div>
                        <div class="col-md-4"><label asp-for="SlotStartTime" class="form-label"></label><input asp-for="SlotStartTime" type="time" class="form-control" /></div>
                        <div class="col-md-4"><label asp-for="SlotEndTime" class="form-label"></label><input asp-for="SlotEndTime" type="time" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="VisitType" class="form-label"></label><input asp-for="VisitType" class="form-control" /></div>
                        <div class="col-md-6"><div class="form-check mt-5"><input asp-for="IsTeleConsultation" class="form-check-input" /><label asp-for="IsTeleConsultation" class="form-check-label"></label></div></div>
                        <div class="col-12"><label asp-for="ReasonForVisit" class="form-label"></label><textarea asp-for="ReasonForVisit" class="form-control"></textarea></div>
                    </div>
                    <div class="mt-4 d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary">Book Appointment</button>
                        <a asp-action="SearchPatients" class="btn btn-outline-secondary">Back to Reception</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model Frontend.Models.Reception.RegisterPatientByReceptionRequestDto
@{
    ViewData["Title"] = "Register Patient";
}

<div class="page-header">
    <div>
        <h1>Register Patient</h1>
        <p class="page-subtitle">Create a new patient record from the reception desk in a clean professional form.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card border-0">
            <div class="card-body p-4 p-lg-5">
                <form asp-action="RegisterPatient" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MobileNumber" class="form-label"></label>
                            <input asp-for="MobileNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mt-3">
                                <input asp-for="PortalAccessEnabled" class="form-check-input" />
                                <label asp-for="PortalAccessEnabled" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mt-3">
                                <input asp-for="SendPortalActivationSms" class="form-check-input" />
                                <label asp-for="SendPortalActivationSms" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-success">Register Patient</button>
                        <a asp-action="SearchPatients" class="btn btn-outline-secondary">Search Existing Patients</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

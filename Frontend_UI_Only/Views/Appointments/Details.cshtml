@model AppointmentDetailsViewModel
@{
    ViewData["Title"] = "Appointment Details";
}

<h1>Appointment #@Model.Appointment.Id</h1>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert success">@Model.Message</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert error">@Model.ErrorMessage</div>
}

<div class="card">
    <div class="details-grid">
        <div><strong>Patient Id:</strong> @Model.Appointment.PatientId</div>
        <div><strong>UHID:</strong> @Model.Appointment.UHID</div>
        <div><strong>Doctor:</strong> @Model.Appointment.DoctorName (@Model.Appointment.DoctorId)</div>
        <div><strong>Department:</strong> @Model.Appointment.DepartmentName (@Model.Appointment.DepartmentId)</div>
        <div><strong>Date:</strong> @Model.Appointment.AppointmentDate.ToString("dd-MMM-yyyy")</div>
        <div><strong>Time:</strong> @Model.Appointment.SlotStartTime - @Model.Appointment.SlotEndTime</div>
        <div><strong>Visit Type:</strong> @Model.Appointment.VisitType</div>
        <div><strong>Status:</strong> @Model.Appointment.Status</div>
        <div><strong>Tele Consultation:</strong> @(Model.Appointment.IsTeleConsultation ? "Yes" : "No")</div>
        <div><strong>Created:</strong> @Model.Appointment.CreatedAtUtc.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</div>
        <div class="full-width"><strong>Reason:</strong> @Model.Appointment.ReasonForVisit</div>
        <div class="full-width"><strong>Cancellation Reason:</strong> @Model.Appointment.CancellationReason</div>
        <div class="full-width"><strong>Completion Notes:</strong> @Model.Appointment.CompletionNotes</div>
    </div>
</div>

<div class="three-column">
    <div class="card">
        <h2>Reschedule</h2>
        <form asp-action="Reschedule" asp-route-id="@Model.Appointment.Id" method="post" class="stack-form">
            <div>
                <label asp-for="Reschedule.NewAppointmentDate"></label>
                <input asp-for="Reschedule.NewAppointmentDate" type="date"
                       value="@Model.Reschedule.NewAppointmentDate.ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <label asp-for="Reschedule.NewSlotStartTime"></label>
                <input asp-for="Reschedule.NewSlotStartTime" type="time"
                       value="@Model.Reschedule.NewSlotStartTime.ToString("HH\\:mm")" />
            </div>
            <div>
                <label asp-for="Reschedule.NewSlotEndTime"></label>
                <input asp-for="Reschedule.NewSlotEndTime" type="time"
                       value="@Model.Reschedule.NewSlotEndTime.ToString("HH\\:mm")" />
            </div>
            <div>
                <label asp-for="Reschedule.Reason"></label>
                <textarea asp-for="Reschedule.Reason"></textarea>
            </div>
            <button type="submit" class="btn">Reschedule</button>
        </form>
    </div>

    <div class="card">
        <h2>Cancel</h2>
        <form asp-action="Cancel" asp-route-id="@Model.Appointment.Id" method="post" class="stack-form">
            <div>
                <label asp-for="Cancel.Reason"></label>
                <textarea asp-for="Cancel.Reason"></textarea>
            </div>
            <button type="submit" class="btn danger">Cancel Appointment</button>
        </form>
    </div>

    <div class="card">
        <h2>Complete</h2>
        <form asp-action="Complete" asp-route-id="@Model.Appointment.Id" method="post" class="stack-form">
            <div>
                <label asp-for="Complete.Notes"></label>
                <textarea asp-for="Complete.Notes"></textarea>
            </div>
            <button type="submit" class="btn">Mark Completed</button>
        </form>
    </div>
</div>

<div class="form-actions">
    <a asp-action="Index" class="btn secondary">Back to Search</a>
    <a asp-action="ByPatient" asp-route-patientId="@Model.Appointment.PatientId" class="btn secondary">Patient Appointments</a>
    <a asp-action="ByDoctor" asp-route-doctorId="@Model.Appointment.DoctorId" class="btn secondary">Doctor Appointments</a>
</div>
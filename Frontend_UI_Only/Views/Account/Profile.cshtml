@model Hms.Web.Models.Auth.CurrentUserResponseDto
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="mb-1">Patient Profile</h2>
                            <p class="text-muted mb-0">Logged-in account details</p>
                        </div>
                        <a asp-action="Logout" class="btn btn-outline-danger">Logout</a>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <div class="text-muted small">User ID</div>
                                <div class="fw-bold">@Model.UserId</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <div class="text-muted small">Patient ID</div>
                                <div class="fw-bold">@Model.PatientId</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <div class="text-muted small">UHID</div>
                                <div class="fw-bold">@Model.UHID</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <div class="text-muted small">Mobile Number</div>
                                <div class="fw-bold">@Model.MobileNumber</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <div class="text-muted small">Role</div>
                                <div class="fw-bold">@Model.Role</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>